---
import BaseLayouts from '../layouts/BaseLayouts.astro';
---

<BaseLayouts title="Minnaar - Matthews Creative House">
  <main class="relative bg-[#FAF7F2] text-neutral-900 py-24 px-6 min-h-screen w-full font-sans antialiased">
    
    <div class="max-w-7xl mx-auto space-y-24">
      
      {/* Header Block */}
      <header class="border-b border-neutral-900 pb-12 pt-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8 space-y-4">
            <span class="text-[11px] font-mono tracking-[0.3em] uppercase text-[#8C6D43]">
              Archive / Selected Works
            </span>
            <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight leading-[0.95]">
              Digital Systems &amp; Brand Artifacts
            </h1>
          </div>
          <div class="lg:col-span-4 lg:pl-6">
            <p class="text-neutral-700 text-sm sm:text-base font-light leading-relaxed">
              Bespoke web architectures engineered to replace template noise with absolute clarity, sub-second performance, and quiet authority.
            </p>
          </div>
        </div>
      </header>

      {/* Major Showcase Project */}
      <section class="space-y-8">
        <div class="flex items-center justify-between border-b border-neutral-300 pb-4">
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 bg-[#3B151A]"></span>
            <span class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-900 font-bold">
              Case No. 01 — Live Flagship Build
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500">2026 Deployment</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          {/* Visual Frame */}
          <div class="lg:col-span-7 bg-[#EFECE6] p-8 sm:p-16 border border-neutral-300 relative group">
            <div class="relative aspect-[4/3] w-full flex items-center justify-center p-8 bg-[#FAF7F2] border border-neutral-200 shadow-sm transition-transform duration-500 group-hover:-translate-y-1">
              <img
                src="/minnaar-matthews-logo.png"
                alt="Minnaar - Matthews Creative House Logo"
                width="500"
                height="500"
                class="w-full h-auto max-h-[280px] object-contain filter contrast-125"
              />
            </div>
            <div class="mt-6 flex justify-between items-center text-[10px] font-mono text-neutral-500 uppercase tracking-widest">
              <span>Asset: Studio Identity &amp; Platform</span>
              <span>Framework: Astro JS</span>
            </div>
          </div>

          {/* Content & Context */}
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <p class="text-xs font-mono uppercase tracking-widest text-[#8C6D43]">
                Full-Service Creative Agency &amp; Studio
              </p>
              <h2 class="font-serif text-3xl sm:text-4xl text-neutral-950 font-normal leading-tight">
                Minnaar - Matthews Creative House
              </h2>
            </div>

            <div class="space-y-6 text-neutral-800 text-sm leading-relaxed font-light border-l-2 border-[#3B151A] pl-6">
              <div>
                <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-900 font-bold mb-1">
                  The Imperative
                </h3>
                <p>
                  A high-end media production house required an ultra-fast visual platform capable of exhibiting high-resolution commercial assets without compromising speed or operational elegance.
                </p>
              </div>
              <div>
                <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-900 font-bold mb-1">
                  Architectural Response
                </h3>
                <p>
                  Engineered on an Astro-first setup with tailored inquiry flows, yielding instantaneous page transitions and a minimal, content-first layout.
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-neutral-300 text-[11px] font-mono text-neutral-600 space-y-1">
              <p>— Astro Architecture</p>
              <p>— Custom Lead Capture Integration</p>
              <p>— Zero-JS Client-Side Rendering Focus</p>
            </div>

            <div class="pt-4">
              <a
                href="https://photo-studio-site-one.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-4 bg-[#3B151A] hover:bg-[#4A121A] text-[#BA996E] text-xs font-mono uppercase tracking-[0.2em] py-4 px-8 transition-colors duration-300"
              >
                <span>Explore Live Deployment</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </div>
      </section>

      {/* Demonstrated Systems */}
      <section class="space-y-8 pt-12 border-t border-neutral-900">
        <div class="flex justify-between items-baseline">
          <h2 class="font-serif text-3xl text-neutral-950">
            Demonstrated Systems
          </h2>
          <span class="text-xs font-mono uppercase text-neutral-500 tracking-widest">
            Prototypes &amp; Specifications
          </span>
        </div>

        <div class="divide-y divide-neutral-300 border-y border-neutral-300">
          
          <div class="py-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-start hover:bg-[#EFECE6]/50 transition-colors duration-300 px-2">
            <div class="md:col-span-2 font-mono text-xs uppercase tracking-widest text-[#8C6D43] font-bold">
              Spec 01 / Retail
            </div>
            <div class="md:col-span-4 space-y-1">
              <h3 class="font-serif text-xl text-neutral-950">
                Boutique E-Commerce Architecture
              </h3>
              <p class="text-xs font-mono text-neutral-500">Next.js • Tailwind • Local Gateways</p>
            </div>
            <div class="md:col-span-6 text-neutral-700 text-sm font-light leading-relaxed">
              A high-speed commerce engine with instant client-side filtering, seamless checkout state management, and direct integration with South African gateways (PayFast &amp; Yoco).
            </div>
          </div>

          <div class="py-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-start hover:bg-[#EFECE6]/50 transition-colors duration-300 px-2">
            <div class="md:col-span-2 font-mono text-xs uppercase tracking-widest text-[#8C6D43] font-bold">
              Spec 02 / Agency
            </div>
            <div class="md:col-span-4 space-y-1">
              <h3 class="font-serif text-xl text-neutral-950">
                Executive Service Platform
              </h3>
              <p class="text-xs font-mono text-neutral-500">Next.js • Web3Forms • Technical SEO</p>
            </div>
            <div class="md:col-span-6 text-neutral-700 text-sm font-light leading-relaxed">
              Corporate web application designed for advisory and executive firms. Features interactive service scoping, schema structured data, and automated routing for high-value leads.
            </div>
          </div>

        </div>
      </section>

      {/* Monolithic Call to Action */}
      <section class="bg-[#3B151A] text-white p-12 sm:p-20 text-left border-l-4 border-[#BA996E] flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="space-y-4 max-w-2xl">
          <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#BA996E]">
            Initiate Project
          </span>
          <h2 class="font-serif text-3xl sm:text-5xl font-normal leading-tight text-white">
            Have a platform to build or modernize?
          </h2>
          <p class="text-neutral-300 text-sm font-light leading-relaxed">
            We engineer custom web platforms built around your business goals, technical constraints, and brand positioning.
          </p>
        </div>
        <div>
          <a
            href="/contact"
            class="inline-block bg-[#BA996E] hover:bg-[#a8885e] text-[#3B151A] text-xs font-mono uppercase tracking-[0.25em] font-bold py-4 px-10 transition-colors duration-300 whitespace-nowrap"
          >
            Start Technical Discovery &rarr;
          </a>
        </div>
      </section>

    </div>
  </main>
</BaseLayouts>