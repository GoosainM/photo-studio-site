---
// src/pages/index.astro
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minnaar-Matthews | Creative House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;1,300&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="editorial-site">
      <div class="ambient-backdrop"></div>

      <!-- Persistent Top Header -->
      <header class="site-top-bar">
        <span class="meta-tag">Maison &bull; Haute Collection</span>
        <span class="meta-location">Cape Town, South Africa</span>
      </header>

      <!-- Main Scrolling Sections -->
      <main class="scroll-container">
        
        <!-- SECTION 01: HOME -->
        <section id="home" class="editorial-section">
          <div class="section-inner home-grid">
            <div class="brand-block">
              <span class="chic-badge">Pure Design Studio</span>
              <h1 class="brand-title">
                Minnaar<span class="separator">&mdash;</span><br />
                <span class="italic-surname">Matthews</span>
              </h1>
              <p class="brand-caption">Creative House &bull; Architectural &amp; Digital Precision</p>
            </div>
            <div class="intro-statement">
              <p>Curating timeless digital sanctuaries and refined brand architectures with the texture of fine Egyptian cotton and uncompromising minimalist clarity.</p>
            </div>
          </div>
        </section>

        <!-- SECTION 02: ABOUT US -->
        <section id="about" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">02 &bull; About Us</span>
            <h2 class="section-heading">The Architecture of Elegance</h2>
            <p class="section-body">
              Rooted in Cape Town, Minnaar-Matthews operates at the intersection of high-end digital craftsmanship and timeless architectural minimalism. Every project is sculpted with intention, structure, and enduring grace.
            </p>
          </div>
        </section>

        <!-- SECTION 03: PORTFOLIO -->
        <section id="portfolio" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">03 &bull; Portfolio</span>
            <h2 class="section-heading">Selected Works</h2>
            <p class="section-body">
              A curated exhibition of digital platforms, custom e-commerce web architecture, and brand identities engineered for global distinction.
            </p>
          </div>
        </section>

        <!-- SECTION 04: REVIEW -->
        <section id="review" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">04 &bull; Review</span>
            <h2 class="section-heading">Client Reflections</h2>
            <p class="section-body">
              "Working with Minnaar-Matthews transformed our digital presence into a timeless work of art. The precision and elegance are unmatched."
            </p>
          </div>
        </section>

        <!-- SECTION 05: CONTACT -->
        <section id="contact" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">05 &bull; Contact</span>
            <h2 class="section-heading">Initiate a Dialogue</h2>
            <p class="section-body">
              For bespoke inquiries, architectural web builds, and creative direction, connect with our studio directly in Cape Town.
            </p>
          </div>
        </section>

      </main>

      <!-- Persistent Footer Navigation & Audio -->
      <footer class="site-footer-nav">
        <nav class="home-navigation">
          <span class="index-label">Directory // Scroll Index</span>
          <ul class="home-menu">
            <li><a href="#home" class="nav-link active" data-target="home"><span class="num">01</span><span class="text">Home</span></a></li>
            <li><a href="#about" class="nav-link" data-target="about"><span class="num">02</span><span class="text">About Us</span></a></li>
            <li><a href="#portfolio" class="nav-link" data-target="portfolio"><span class="num">03</span><span class="text">Portfolio</span></a></li>
            <li><a href="#review" class="nav-link" data-target="review"><span class="num">04</span><span class="text">Review</span></a></li>
            <li><a href="#contact" class="nav-link" data-target="contact"><span class="num">05</span><span class="text">Contact</span></a></li>
          </ul>
        </nav>

        <div class="audio-footer-bar">
          <audio id="bgAudio" loop preload="auto">
            <source src="/ambient.mp3" type="audio/mpeg" />
          </audio>
          <button class="audio-trigger" id="audioToggle" aria-label="Toggle Audio">
            <span class="audio-dot"></span>
            <span id="audioText">Soundscape: Off</span>
          </button>
        </div>
      </footer>
    </div>

    <script>
      // Audio Control Script
      const audio = document.getElementById('bgAudio') as HTMLAudioElement;
      const audioToggle = document.getElementById('audioToggle');
      const audioText = document.getElementById('audioText');
      let isPlaying = false;

      audioToggle?.addEventListener('click', () => {
        if (isPlaying) {
          audio.pause();
          if(audioText) audioText.textContent = 'Soundscape: Off';
          audioToggle.classList.remove('playing');
          isPlaying = false;
        } else {
          audio.volume = 0.3; 
          audio.play().then(() => {
            if(audioText) audioText.textContent = 'Soundscape: Active';
            audioToggle.classList.add('playing');
            isPlaying = true;
          }).catch(err => {
            console.log("Audio play failed:", err);
          });
        }
      });

      // Intersection Observer to update active menu link on scroll
      const sections = document.querySelectorAll('.editorial-section');
      const navLinks = document.querySelectorAll('.nav-link');

      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
          const sectionTop = section.getBoundingClientRect().top;
          if (sectionTop <= window.innerHeight / 3) {
            current = section.getAttribute('id') || '';
          }
        });

        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('data-target') === current) {
            link.classList.add('active');
          }
        });
      });
    </script>

    <style>
      :root {
        --color-cotton-bg: #F7F5F0;     
        --color-obsidian: #141312;      
        --color-charcoal: #3A3835;      
        --color-muted: #7E7870;         
        --color-border: rgba(20, 19, 18, 0.12); 
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        background-color: var(--color-cotton-bg);
        color: var(--color-obsidian);
        font-family: 'Jost', sans-serif;
      }

      .editorial-site {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        background-color: var(--color-cotton-bg);
        display: flex;
        flex-direction: column;
      }

      .ambient-backdrop {
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.8) 0%, rgba(247, 245, 240, 1) 75%);
        pointer-events: none;
        z-index: 0;
      }

      .site-top-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        padding: 25px 8vw;
        font-size: 0.65rem;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-border);
        background: rgba(247, 245, 240, 0.9);
        backdrop-filter: blur(10px);
        z-index: 10;
      }

      .scroll-container {
        position: relative;
        z-index: 2;
        padding-top: 100px; /* clears fixed top bar */
      }

      .editorial-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 8vh 8vw;
        box-sizing: border-box;
        border-bottom: 1px solid var(--color-border);
      }

      .section-inner {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
      }

      .home-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
        align-items: flex-end;
      }

      .chic-badge {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: var(--color-charcoal);
        margin-bottom: 20px;
        display: inline-block;
        border-bottom: 1px solid var(--color-charcoal);
        padding-bottom: 4px;
        opacity: 0.8;
      }

      .brand-title {
        font-family: 'Playfair Display', serif;
        font-weight: 300;
        font-size: clamp(3rem, 6.5vw, 5.8rem);
        color: var(--color-obsidian);
        line-height: 1.05;
        letter-spacing: 0.04em;
        margin: 0;
        text-transform: uppercase;
      }

      .brand-title .separator {
        color: var(--color-muted);
        font-weight: 200;
        margin: 0 12px;
      }

      .brand-title .italic-surname {
        font-style: italic;
        font-weight: 400;
        letter-spacing: 0.02em;
        color: var(--color-charcoal);
      }

      .brand-caption {
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-top: 2rem;
      }

      .intro-statement, .section-body {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--color-charcoal);
        opacity: 0.9;
        max-width: 500px;
        letter-spacing: 0.03em;
      }

      .section-heading {
        font-family: 'Playfair Display', serif;
        font-weight: 300;
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: var(--color-obsidian);
        margin: 0 0 1.5rem 0;
        text-transform: uppercase;
      }

      /* Fixed or Sticky Bottom Navigation */
      .site-footer-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        background: rgba(247, 245, 240, 0.92);
        backdrop-filter: blur(12px);
        border-top: 1px solid var(--color-border);
        padding: 20px 8vw;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 10;
      }

      .home-navigation {
        display: flex;
        flex-direction: column;
      }

      .index-label {
        font-size: 0.55rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-bottom: 6px;
      }

      .home-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 3vw;
      }

      .nav-link {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        text-decoration: none;
      }

      .nav-link .num {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        color: var(--color-muted);
        transition: color 0.3s ease;
      }

      .nav-link .text {
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        letter-spacing: 0.1em;
        color: var(--color-charcoal);
        opacity: 0.6;
        transition: all 0.3s ease;
      }

      .nav-link:hover .text, .nav-link.active .text {
        opacity: 1;
        color: var(--color-obsidian);
        letter-spacing: 0.14em;
      }

      .nav-link:hover .num, .nav-link.active .num {
        color: var(--color-obsidian);
      }

      .audio-trigger {
        background: transparent;
        border: 1px solid rgba(20, 19, 18, 0.2);
        color: var(--color-obsidian);
        padding: 8px 16px;
        font-family: 'Jost', sans-serif;
        font-size: 0.6rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .audio-dot {
        width: 5px;
        height: 5px;
        background-color: var(--color-muted);
        border-radius: 50%;
        transition: background-color 0.3s ease;
      }

      .audio-trigger.playing .audio-dot {
        background-color: #2e7d32;
        box-shadow: 0 0 6px rgba(46, 125, 50, 0.4);
      }

      .audio-trigger:hover {
        border-color: rgba(20, 19, 18, 0.45);
        background: rgba(20, 19, 18, 0.03);
      }

      @media(max-width: 992px) {
        .home-grid {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }
        .site-footer-nav {
          flex-direction: column;
          gap: 12px;
          padding: 15px 4vw;
        }
        .home-menu {
          gap: 2vw;
        }
      }
    </style>
  </body>
</html>