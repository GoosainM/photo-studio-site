---
// src/components/Hero.astro
---

<div class="page-container">
  <!-- Background Image -->
  <div class="bg"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>

  <!-- Main Content Area -->
  <div class="content-wrapper">
    <div class="brand-block">
      <span class="chic-badge">Studio Collection</span>
      <h1 class="brand-name">Minnaar-Matthews</h1>
      <p class="brand-sub">Creative House &bull; Pure Design</p>
    </div>
  </div>

  <!-- Side Bar Menu (Desktop) / Top Bar (Mobile) -->
  <aside class="sidebar-menu">
    <div class="sidebar-header">
      <span class="sidebar-subtitle">Index</span>
      <h3>Navigation</h3>
    </div>
    <ul class="sidebar-links">
      <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span>01. Home</span></a></li>
      <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span>02. About Us</span></a></li>
      <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span>03. Portfolio</span></a></li>
      <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span>04. Review</span></a></li>
      <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span>05. Contact</span></a></li>
    </ul>

    <!-- Audio Player inside Sidebar Footer -->
    <div class="sidebar-footer">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-btn" id="audioToggle" aria-label="Toggle Audio">
        <svg class="sound-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
          <path class="speaker" d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path class="wave1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="audioText">Sound: Off</span>
      </button>
    </div>
  </aside>
</div>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Sound: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.35; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Sound: On';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      if (window.innerWidth > 768) {
        const targetId = link.getAttribute('data-target');
        bannerLayers.forEach(banner => {
          if (banner.id === targetId) {
            banner.classList.add('active');
          } else {
            banner.classList.remove('active');
          }
        });
      }
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelector('.sidebar-links')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --cream: #F9F8F6;
    --pure-white: #FFFFFF;
    --charcoal: #1C1B1A;
  }

  .page-container {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background-color: var(--charcoal);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.85) contrast(105%);
    z-index: 0;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.95) contrast(125%);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.85;
  }

  /* Main Content Layout */
  .content-wrapper {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .brand-block {
    width: 100%;
    max-width: 550px;
    padding: 35px 25px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(28, 27, 26, 0.65);
    backdrop-filter: blur(12px);
    text-align: center;
  }

  .chic-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--cream);
    margin-bottom: 12px;
    opacity: 0.8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    display: inline-block;
    padding-bottom: 3px;
  }

  .brand-name {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 6vw, 3.2rem);
    color: var(--pure-white);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    word-wrap: break-word;
  }

  .brand-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--cream);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 12px;
    opacity: 0.9;
  }

  /* Sidebar Menu */
  .sidebar-menu {
    position: relative;
    z-index: 10;
    width: 340px;
    min-height: 100vh;
    background: rgba(20, 19, 18, 0.96);
    backdrop-filter: blur(16px);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 30px;
  }

  .sidebar-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 15px;
  }

  .sidebar-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(249, 248, 246, 0.5);
    margin-bottom: 4px;
    display: block;
  }

  .sidebar-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--pure-white);
    margin: 0;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sidebar-links a {
    display: block;
    padding: 6px 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    color: var(--cream);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.3s ease;
  }

  .sidebar-links a:hover {
    color: var(--pure-white);
  }

  .sidebar-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 15px;
  }

  .audio-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--cream);
    padding: 8px 14px;
    border-radius: 4px;
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    width: 100%;
    justify-content: center;
  }

  /* Mobile Phone Layout Breakpoint (Screens under 768px) */
  @media(max-width: 768px) {
    .page-container {
      flex-direction: column;
      height: auto;
    }

    .sidebar-menu {
      width: 100%;
      min-height: auto;
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 30px 20px;
    }

    .content-wrapper {
      padding: 50px 16px;
      min-height: 50vh;
    }

    .brand-block {
      padding: 25px 16px;
    }

    .sidebar-links {
      gap: 10px;
    }

    .sidebar-links a {
      font-size: 1rem;
    }
  }
</style>