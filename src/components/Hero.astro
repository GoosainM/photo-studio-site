---
// Hero.astro for Minnaar-Matthews Creative House
---

<section id="hero" class="relative w-full h-[70vh] md:h-[88vh] mt-20 bg-[#F4F1EA] overflow-hidden">
  <!-- Full-Width Background Image Layer -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src="/hero-bg.png" 
      alt="Minnaar-Matthews Creative House Showcase" 
      class="w-full h-full object-cover object-center"
    />
    <!-- Subtle warm overlay to blend it perfectly with the Egyptian Cotton tone -->
    <div class="absolute inset-0 bg-[#F4F1EA]/15"></div>
  </div>
</section>