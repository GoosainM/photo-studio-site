---
// Portfolio Page - Minnaar-Matthews Creative House
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | Minnaar-Matthews</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Playfair+Display:ital,wght@0,600;0,900;1,400&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-[#1C1B1A] text-[#F4F1EA] font-sans min-h-screen flex flex-col selection:bg-[#F4F1EA] selection:text-[#1C1B1A]">
    
    <!-- Header Navigation -->
    <header class="p-8 flex justify-between items-center border-b border-[#2d2c2a]">
      <a href="/" class="font-serif tracking-[0.15em] text-lg uppercase text-[#F4F1EA] no-underline font-bold">Minnaar-Matthews</a>
      <a href="/" class="font-sans text-xs tracking-[0.3em] uppercase hover:opacity-75 transition-opacity text-[#F4F1EA]">&larr; Back to Home</a>
    </header>

    <!-- Main Portfolio Content -->
    <main class="flex-grow max-w-7xl mx-auto px-6 py-20 w-full">
      <div class="text-center mb-16">
        <h1 class="font-serif text-4xl md:text-6xl font-black tracking-wider uppercase mb-4 text-[#F4F1EA]">Portfolio</h1>
        <p class="font-sans font-medium tracking-[0.4em] text-xs uppercase text-gray-400">Selected Works & Visual Archival</p>
      </div>

      <!-- 3-Column Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Tile 1 -->
        <div class="bg-[#242322] border border-[#333] flex flex-col overflow-hidden group p-5 rounded-sm">
          <div class="w-full h-48 overflow-hidden relative mb-5 bg-[#1a1918] rounded-sm">
            <img src="/IMG_0661.jpg" alt="E-Guard Security" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <h3 class="font-serif text-xl tracking-wider mb-2 font-bold text-[#F4F1EA]">E-Guard Security</h3>
              <p class="font-sans text-sm text-gray-300 leading-relaxed">Custom full-stack web architecture and high-performance interactive UI deployment for modern security operations.</p>
            </div>
            <span class="mt-6 font-sans text-xs tracking-[0.2em] uppercase text-gray-400">Web Architecture</span>
          </div>
        </div>

        <!-- Tile 2 -->
        <div class="bg-[#242322] border border-[#333] flex flex-col overflow-hidden group p-5 rounded-sm">
          <div class="w-full h-48 overflow-hidden relative mb-5 bg-[#1a1918] rounded-sm">
            <img src="/IMG_0713.jpg" alt="Visual Art Direction" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <h3 class="font-serif text-xl tracking-wider mb-2 font-bold text-[#F4F1EA]">Visual Art Direction</h3>
              <p class="font-sans text-sm text-gray-300 leading-relaxed">Curated photography showcasing refined editorial lighting, atmosphere, and high-end composition standards.</p>
            </div>
            <span class="mt-6 font-sans text-xs tracking-[0.2em] uppercase text-gray-400">Photography</span>
          </div>
        </div>

        <!-- Tile 3 -->
        <div class="bg-[#242322] border border-[#333] flex flex-col overflow-hidden group p-5 rounded-sm">
          <div class="w-full h-48 overflow-hidden relative mb-5 bg-[#1a1918] rounded-sm">
            <img src="/IMG_0784.jpg" alt="Matthews Developments" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <h3 class="font-serif text-xl tracking-wider mb-2 font-bold text-[#F4F1EA]">Matthews Developments</h3>
              <p class="font-sans text-sm text-gray-300 leading-relaxed">Bespoke digital branding, client showcases, and tailored interactive solutions built for scale and aesthetic precision.</p>
            </div>
            <span class="mt-6 font-sans text-xs tracking-[0.2em] uppercase text-gray-400">Digital Agency</span>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="p-8 text-center text-xs tracking-[0.3em] uppercase border-t border-[#2d2c2a] text-gray-500">
      &copy; 2026 Minnaar-Matthews Creative House. All Rights Reserved.
    </footer>

  </body>
</html>
