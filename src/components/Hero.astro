---
// Hero.astro for Minnaar-Matthews Creative House
---

<section id="corporate" class="relative w-full h-[75vh] md:h-[90vh] overflow-hidden bg-[#1C1B1A]">
  
  <!-- Full-Bleed High-Impact Image Display -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-bg.png" 
      alt="Minnaar-Matthews Creative House Showcase" 
      class="w-full h-full object-cover object-center opacity-100"
    />
    <!-- Subtle dark/warm vignette to frame the photography nicely -->
    <div class="absolute inset-0 bg-black/10"></div>
  </div>

</section>