---
// Navbar.astro for Minnaar-Matthews Creative House
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#F4F1EA]/95 backdrop-blur-md border-b border-[#C5BCAB]/40 w-full" style="max-width: 100vw; overflow-x: hidden;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between flex-nowrap">
    
    <!-- Logo -->
    <a href="#" class="flex items-center flex-shrink-0" style="height: 40px;">
      <img 
        src="/logo.png" 
        alt="Minnaar-Matthews Creative House Logo" 
        style="height: 100%; width: auto; max-height: 40px; object-fit: contain;"
      />
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#5A5348] flex-nowrap">
      <a href="#corporate" class="hover:text-[#1C1B1A] transition-colors whitespace-nowrap">About us</a>
      <a href="#portfolio" class="hover:text-[#1C1B1A] transition-colors whitespace-nowrap">Portfolio</a>
      <a href="#reviews" class="hover:text-[#1C1B1A] transition-colors whitespace-nowrap">Reviews</a>
      <a href="#contact" class="hover:text-[#1C1B1A] transition-colors whitespace-nowrap">Contact Us</a>
    </nav>

    <!-- WhatsApp Book Session Button -->
    <a 
      href="https://wa.me/27817586537?text=Hi%20Melissa!%20I'd%20like%20to%20enquire%20about%20booking%20a%20photography%20session." 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-[#E8E4DC] border border-[#C5BCAB] text-[#1C1B1A] text-xs font-semibold uppercase tracking-wider px-4 py-2 hover:bg-[#DCD7CD] transition-colors rounded-sm shadow-sm flex-shrink-0 whitespace-nowrap"
    >
      Book Session
    </a>
  </div>
</header>