---
---
<section id="enquire" class="py-24 bg-neutral-950 text-white px-6 border-t border-neutral-800">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-400 mb-2">Enquire</h2>
      <h3 class="text-3xl font-light">Request a Shoot Quote</h3>
    </div>

    <form class="space-y-6">
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs uppercase tracking-wider text-neutral-400 mb-2">Full Name *</label>
          <input type="text" required class="w-full bg-neutral-900 border border-neutral-800 p-3 text-white focus:outline-none focus:border-white transition" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-neutral-400 mb-2">Company / Organization</label>
          <input type="text" class="w-full bg-neutral-900 border border-neutral-800 p-3 text-white focus:outline-none focus:border-white transition" />
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs uppercase tracking-wider text-neutral-400 mb-2">Email *</label>
          <input type="email" required class="w-full bg-neutral-900 border border-neutral-800 p-3 text-white focus:outline-none focus:border-white transition" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wider text-neutral-400 mb-2">Primary Shooting Type</label>
          <select class="w-full bg-neutral-900 border border-neutral-800 p-3 text-white focus:outline-none focus:border-white transition">
            <option>Executive Headshots (On-site)</option>
            <option>Portrait Session</option>
            <option>Corporate Event Coverage</option>
            <option>Commercial / Product Shooting</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-wider text-neutral-400 mb-2">Project Details & Dates</label>
        <textarea rows="4" class="w-full bg-neutral-900 border border-neutral-800 p-3 text-white focus:outline-none focus:border-white transition" placeholder="Tell us about the scope, team size, location preference, or turnaround deadlines..."></textarea>
      </div>

      <button type="submit" class="w-full bg-white text-black py-4 font-semibold uppercase text-xs tracking-widest hover:bg-neutral-200 transition">
        Submit Booking enquiry
      </button>
    </form>
  </div>
</section>