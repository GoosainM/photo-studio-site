---
// Landing Page - Minnaar-Matthews Creative House
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minnaar-Matthews | Creative House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
    <style>
      /* Sparkle Animation Keyframes */
      @keyframes sparklePop {
        0% { transform: scale(0.2) translateY(0); opacity: 1; }
        100% { transform: scale(1.4) translateY(-35px); opacity: 0; }
      }
      .sparkle {
        position: absolute;
        pointer-events: none;
        width: 8px;
        height: 8px;
        background-color: #D4AF37;
        border-radius: 50%;
        box-shadow: 0 0 8px #D4AF37;
        animation: sparklePop 0.6s ease-out forwards;
        z-index: 9999;
      }
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        color: #FFFFFF;
        font-family: 'Jost', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }
    </style>
  </head>
  <body>
    
    <!-- Background Audio -->
    <audio id="bg-audio" loop>
      <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf756.mp3?filename=gentle-jazz-lofi-111181.mp3" type="audio/mpeg">
    </audio>

    <!-- Top Floating Minimal Nav & Audio Control -->
    <header style="position: absolute; top: 0; left: 0; width: 100%; z-index: 50; display: flex; justify-content: space-between; align-items: center; padding: 2rem 3rem;">
      <!-- Audio Toggle -->
      <button id="audio-toggle" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.3); padding: 0.4rem 0.8rem; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; color: #FFFFFF; display: flex; align-items: center; gap: 0.4rem;">
        <span id="audio-icon">&#9834;</span> <span id="audio-text">Sound</span>
      </button>

      <!-- Navigation Links -->
      <div style="display: flex; gap: 2rem;">
        <a href="/portfolio" style="color: #FFFFFF; text-decoration: none; font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Portfolio</a>
        <a href="/contact" style="color: #FFFFFF; text-decoration: none; font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Inquiries</a>
      </div>
    </header>

    <!-- Full-Screen Immersive Hero Section matching reference image -->
    <main style="position: relative; width: 100vw; height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden;">
      
      <!-- Background Hero Image -->
      <div style="position: absolute; inset: 0; z-index: 1; background-image: url('/hero-bg.png'); background-size: cover; background-position: center; filter: grayscale(100%) contrast(120%);"></div>
      
      <!-- Subtle Dark Overlay for contrast -->
      <div style="position: absolute; inset: 0; z-index: 2; background-color: rgba(0,0,0,0.25);"></div>

      <!-- Centered Branding Typography -->
      <div style="position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 4rem); font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: #FFFFFF; margin: 0; text-shadow: 0 4px 12px rgba(0,0,0,0.4);">
          Minnaar-Matthews
        </h1>
        <span style="font-size: 0.65rem; letter-spacing: 0.5em; text-transform: uppercase; color: rgba(255,255,255,0.85); text-shadow: 0 2px 6px rgba(0,0,0,0.5);">
          Creative House
        </span>
      </div>

    </main>

    <!-- Interactive Script for Audio & Sparkles -->
    <script>
      const audio = document.getElementById('bg-audio');
      const audioToggle = document.getElementById('audio-toggle');
      const audioText = document.getElementById('audio-text');
      const audioIcon = document.getElementById('audio-icon');
      let isPlaying = false;

      audioToggle.addEventListener('click', () => {
        if (!isPlaying) {
          audio.play().then(() => {
            isPlaying = true;
            audioText.textContent = 'Pause';
            audioIcon.innerHTML = '&#9612;&#9612;';
          }).catch(e => console.log("Audio play blocked:", e));
        } else {
          audio.pause();
          isPlaying = false;
          audioText.textContent = 'Sound';
          audioIcon.innerHTML = '&#9834;';
        }
      });

      // Sparkle Effect on Click
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a, button');
        if (target) {
          const rect = target.getBoundingClientRect();
          const x = e.clientX || (rect.left + rect.width / 2);
          const y = e.clientY || (rect.top + rect.height / 2);

          for (let i = 0; i < 6; i++) {
            const sparkle = document.createElement('div');
            sparkle.className = 'sparkle';
            
            const angle = Math.random() * Math.PI * 2;
            const distance = 15 + Math.random() * 25;
            const destX = Math.cos(angle) * distance;
            const destY = Math.sin(angle) * distance;

            sparkle.style.left = `${x}px`;
            sparkle.style.top = `${y}px`;
            sparkle.style.transform = `translate(${destX}px, ${destY}px)`;
            
            document.body.appendChild(sparkle);

            setTimeout(() => {
              sparkle.remove();
            }, 600);
          }
        }
      });
    </script>

  </body>
</html>