---
const reviews = [
  {
    quote: "Melissa captured our family flawlessly. The lighting and turnaround time were unmatched.",
    author: "Carla M.",
    platform: "Instagram"
  },
  {
    quote: "An absolute professional on set. The headshots completely transformed my image.",
    author: "Ashleigh.",
    platform: "Instagram"
  },
  {
    quote: "Fast, efficient, and exceptionally talented. The mobile studio setup made our shoot effortless.",
    author: "Jason L.",
    platform: "Facebook"
  }
];
---
<section id="reviews" class="py-20 bg-neutral-950 text-white px-6 border-t border-neutral-900">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-neutral-400 mb-2">Testimonials & Social</p>
        <h2 class="font-serif text-3xl md:text-4xl font-bold tracking-tight">Client Endorsements & Feed</h2>
      </div>

      <a 
        href="https://www.instagram.com/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-neutral-300 hover:text-white transition underline"
      >
        Follow on Instagram →
      </a>
    </div>

    <!-- Grid Layout: Reviews + Live Instagram Feed -->
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Left Column: Reviews -->
      <div class="space-y-6">
        {reviews.map((item) => (
          <div class="bg-neutral-900/50 border border-neutral-800 p-6 flex flex-col justify-between">
            <div>
              <div class="text-amber-400 text-xs mb-3">★★★★★</div>
              <p class="text-neutral-300 text-sm leading-relaxed mb-4 italic">
                "{item.quote}"
              </p>
            </div>
            <div class="border-t border-neutral-800 pt-3">
              <p class="font-semibold text-xs text-white">{item.author}</p>
              <p class="text-neutral-500 text-[11px]">{item.role}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: Elfsight Instagram Widget Container -->
      <div class="lg:col-span-2 bg-neutral-900/30 border border-neutral-800 p-6 rounded">
        <p class="text-xs font-mono uppercase tracking-widest text-neutral-400 mb-4">Latest Instagram Posts</p>
        
        <!-- Elfsight Instagram Feed | Untitled Instagram Feed -->
<script src="https://elfsightcdn.com/platform.js" async></script>
<div class="elfsight-app-928f87a2-ef93-4136-8057-343cc9a2efbe" data-elfsight-app-lazy></div>
        
      </div>

    </div>
  </div>
</section>