---
// src/components/Hero.astro
---

<section class="editorial-home">
  <!-- Soft Atmospheric Egyptian Cotton Minimalist Backdrop -->
  <div class="ambient-backdrop"></div>

  <!-- Main Editorial Content Canvas -->
  <div class="home-container">
    <header class="home-top-bar">
      <span class="meta-tag">Maison &bull; Haute Collection</span>
      <span class="meta-location">Cape Town, South Africa</span>
    </header>

    <main class="home-hero-content">
      <div class="brand-block">
        <span class="chic-badge">Pure Design Studio</span>
        <h1 class="brand-title">
          Minnaar<span class="separator">&mdash;</span><br />
          <span class="italic-surname">Matthews</span>
        </h1>
        <p class="brand-caption">Creative House &bull; Architectural &amp; Digital Precision</p>
      </div>

      <div class="intro-statement">
        <p>Curating timeless digital sanctuaries and refined brand architectures with the texture of fine Egyptian cotton and uncompromising minimalist clarity.</p>
      </div>
    </main>

    <!-- Editorial Navigation Bar -->
    <nav class="home-navigation">
      <span class="index-label">Directory // Index</span>
      <ul class="home-menu">
        <li><a href="#" class="nav-link active"><span class="num">01</span><span class="text">Home</span></a></li>
        <li><a href="/about" class="nav-link"><span class="num">02</span><span class="text">About Us</span></a></li>
        <li><a href="/portfolio" class="nav-link"><span class="num">03</span><span class="text">Portfolio</span></a></li>
        <li><a href="/review" class="nav-link"><span class="num">04</span><span class="text">Review</span></a></li>
        <li><a href="/contact" class="nav-link"><span class="num">05</span><span class="text">Contact</span></a></li>
      </ul>
    </nav>

    <!-- Audio Player Footer -->
    <footer class="home-footer">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-trigger" id="audioToggle" aria-label="Toggle Audio">
        <span class="audio-dot"></span>
        <span id="audioText">Soundscape: Off</span>
      </button>
    </footer>
  </div>
</section>

<script>
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', () => {
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Soundscape: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.3; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Soundscape: Active';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });
</script>

<style>
  :root {
    --color-cotton-bg: #F7F5F0;     /* Pure Egyptian Cotton Soft Ivory */
    --color-obsidian: #141312;      /* Deep rich contrast black */
    --color-charcoal: #3A3835;      /* Sophisticated secondary tone */
    --color-muted: #7E7870;         /* Soft warm gray for indices */
    --color-border: rgba(20, 19, 18, 0.12); /* Subtle linen border */
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    background-color: var(--color-cotton-bg);
    color: var(--color-obsidian);
    font-family: 'Jost', sans-serif;
  }

  .editorial-home {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    background-color: var(--color-cotton-bg);
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  .ambient-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.8) 0%, rgba(247, 245, 240, 1) 75%);
    pointer-events: none;
    z-index: 0;
  }

  .home-container {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5vh 8vw;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .home-top-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 20px;
  }

  .home-hero-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: flex-end;
    margin: 8vh 0;
  }

  .chic-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--color-charcoal);
    margin-bottom: 20px;
    display: inline-block;
    border-bottom: 1px solid var(--color-charcoal);
    padding-bottom: 4px;
    opacity: 0.8;
  }

  .brand-title {
    font-family: 'Playfair Display', serif;
    font-weight: 300;
    font-size: clamp(3rem, 6.5vW, 5.8rem);
    color: var(--color-obsidian);
    line-height: 1.05;
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  .brand-title .separator {
    color: var(--color-muted);
    font-weight: 200;
    margin: 0 12px;
  }

  .brand-title .italic-surname {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-charcoal);
  }

  .brand-caption {
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 2rem;
  }

  .intro-statement {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-charcoal);
    opacity: 0.9;
    max-width: 440px;
    letter-spacing: 0.03em;
  }

  .home-navigation {
    border-top: 1px solid var(--color-border);
    padding-top: 30px;
    margin-bottom: 40px;
  }

  .index-label {
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: block;
    margin-bottom: 20px;
  }

  .home-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 4vw;
    flex-wrap: wrap;
  }

  .nav-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    text-decoration: none;
  }

  .nav-link .num {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    transition: color 0.3s ease;
  }

  .nav-link .text {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    color: var(--color-charcoal);
    opacity: 0.7;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover .text, .nav-link.active .text {
    opacity: 1;
    color: var(--color-obsidian);
    letter-spacing: 0.15em;
  }

  .nav-link:hover .num, .nav-link.active .num {
    color: var(--color-obsidian);
  }

  .home-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    display: flex;
    justify-content: flex-end;
  }

  .audio-trigger {
    background: transparent;
    border: 1px solid rgba(20, 19, 18, 0.2);
    color: var(--color-obsidian);
    padding: 10px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .audio-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-muted);
    border-radius: 50%;
    transition: background-color 0.3s ease;
  }

  .audio-trigger.playing .audio-dot {
    background-color: #2e7d32;
    box-shadow: 0 0 8px rgba(46, 125, 50, 0.4);
  }

  .audio-trigger:hover {
    border-color: rgba(20, 19, 18, 0.45);
    background: rgba(20, 19, 18, 0.03);
  }

  /* Responsive Adjustments */
  @media(max-width: 992px) {
    .home-hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin: 5vh 0;
    }

    .home-menu {
      flex-direction: column;
      gap: 16px;
    }

    .home-container {
      padding: 30px 20px;
    }
  }
</style>