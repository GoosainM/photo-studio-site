Set-Content -Path "src/pages/portfolio.astro" -Value @"
---
// Portfolio Page - Minnaar-Matthews Creative House
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | Minnaar-Matthews</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Playfair+Display:ital,wght@0,600;0,900;1,400&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-[#1C1B1A] text-[#F4F1EA] font-sans min-h-screen flex flex-col selection:bg-[#F4F1EA] selection:text-[#1C1B1A]">
    
    <!-- Header Navigation -->
    <header class="p-8 flex justify-between items-center border-b border-[#2d2c2a]">
      <a href="/" class="font-serif tracking-[0.15em] text-lg uppercase text-[#F4F1EA] no-underline font-bold">Minnaar-Matthews</a>
      <a href="/" class="font-sans text-xs tracking-[0.3em] uppercase hover:opacity-75 transition-opacity">&larr; Back to Home</a>
    </header>

    <!-- Main Portfolio Content -->
    <main class="flex-grow max-w-7xl mx-auto px-6 py-20 w-full">
      <div class="text-center mb-16">
        <h1 class="font-serif text-4xl md:text-6xl font-black tracking-wider uppercase mb-4">Portfolio</h1>
        <p class="font-sans font-medium tracking-[0.4em] text-xs uppercase text-gray-400">Selected Works & Creative Archival</p>
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Project 1 -->
        <div class="group relative overflow-hidden bg-[#242322] aspect-[4/5] flex items-center justify-center cursor-pointer border border-[#333]">
          <div class="absolute inset-0 bg-cover bg-center opacity-60 group-hover:scale-105 transition-transform duration-700 ease-out" style="background-image: url('/bg.jpeg');"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
          <div class="relative z-10 text-center p-6">
            <h3 class="font-serif text-2xl tracking-wider mb-2 font-bold">E-Guard Security</h3>
            <p class="font-sans text-xs tracking-[0.25em] uppercase text-gray-300">Web Architecture & Identity</p>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="group relative overflow-hidden bg-[#242322] aspect-[4/5] flex items-center justify-center cursor-pointer border border-[#333]">
          <div class="absolute inset-0 bg-cover bg-center opacity-60 group-hover:scale-105 transition-transform duration-700 ease-out" style="background-image: url('/bg.jpeg');"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
          <div class="relative z-10 text-center p-6">
            <h3 class="font-serif text-2xl tracking-wider mb-2 font-bold">Photography Showcase</h3>
            <p class="font-sans text-xs tracking-[0.25em] uppercase text-gray-300">Visual Art Direction</p>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="group relative overflow-hidden bg-[#242322] aspect-[4/5] flex items-center justify-center cursor-pointer border border-[#333]">
          <div class="absolute inset-0 bg-cover bg-center opacity-60 group-hover:scale-105 transition-transform duration-700 ease-out" style="background-image: url('/bg.jpeg');"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
          <div class="relative z-10 text-center p-6">
            <h3 class="font-serif text-2xl tracking-wider mb-2 font-bold">Matthews Developments</h3>
            <p class="font-sans text-xs tracking-[0.25em] uppercase text-gray-300">Custom Web Applications</p>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="p-8 text-center text-xs tracking-[0.3em] uppercase border-t border-[#2d2c2a] text-gray-500">
      &copy; 2026 Minnaar-Matthews Creative House. All Rights Reserved.
    </footer>

  </body>
</html>
"@