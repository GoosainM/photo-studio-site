---
// src/components/Hero.astro
---

<div class="stage" id="stage">
  <div class="bg"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>
  
  <div class="logo-container" id="logoContainer">
    <div class="chic-badge">Studio Collection</div>
    <h1 class="brand-name">Minnaar-Matthews</h1>
    <div class="brand-sub">Creative House &bull; Pure Design</div>
  </div>

  <!-- Audio element -->
  <audio id="bgAudio" loop preload="auto">
    <source src="/ambient.mp3" type="audio/mpeg" />
  </audio>

  <!-- Audio Toggle Button -->
  <button class="audio-btn" id="audioToggle" aria-label="Toggle Audio">
    <svg class="sound-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
      <path class="speaker" d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <path class="wave1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    </svg>
    <span id="audioText">Sound: Off</span>
  </button>

  <div class="menu-overlay" id="menuOverlay">
    <button class="close-btn" id="closeBtn">&times;</button>
    <div class="menu-inner-grid">
      <div class="menu-header-left">
        <span class="menu-subtitle">Index</span>
        <h2>Navigation</h2>
      </div>
      <ul class="menu-links">
        <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span>01. Home</span></a></li>
        <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span>02. About Us</span></a></li>
        <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span>03. Portfolio</span></a></li>
        <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span>04. Review</span></a></li>
        <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span>05. Contact</span></a></li>
      </ul>
    </div>
  </div>
</div>

<script>
  const stage = document.getElementById('stage');
  const logoContainer = document.getElementById('logoContainer');
  const menuOverlay = document.getElementById('menuOverlay');
  const closeBtn = document.getElementById('closeBtn');
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Sound: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.35; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Sound: On';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  let raf = null;

  stage?.addEventListener('mousemove', (e) => {
    const rect = stage.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    const rotY = (x - 0.5) * 15;
    const rotX = (0.5 - y) * 12;
    if(raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      if(logoContainer) logoContainer.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
    });
  });

  stage?.addEventListener('mouseleave', () => {
    if(raf) cancelAnimationFrame(raf);
    if(logoContainer) logoContainer.style.transform = `rotateX(0deg) rotateY(0deg)`;
  });

  stage?.addEventListener('click', () => {
    menuOverlay?.classList.add('active');
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menuOverlay?.classList.remove('active');
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      const targetId = link.getAttribute('data-target');
      bannerLayers.forEach(banner => {
        if (banner.id === targetId) {
          banner.classList.add('active');
        } else {
          banner.classList.remove('active');
        }
      });
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        menuOverlay?.classList.remove('active');
      } else {
        menuOverlay?.classList.remove('active');
      }
    });
  });

  document.querySelector('.menu-links')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --cream: #F9F8F6;
    --pure-white: #FFFFFF;
    --charcoal: #1C1B1A;
  }

  .stage {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1600px;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--charcoal);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.9) contrast(105%);
    z-index: 0;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.95) contrast(125%);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.82;
  }

  .logo-container {
    position: relative;
    z-index: 3;
    transform-style: preserve-3d;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
    padding: 40px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(28, 27, 26, 0.35);
    backdrop-filter: blur(16px);
    max-width: 700px;
    width: 90%;
  }

  .chic-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--cream);
    margin-bottom: 16px;
    opacity: 0.8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    display: inline-block;
    padding-bottom: 4px;
  }

  .brand-name {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4.5vw, 4.2rem);
    color: var(--pure-white);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .brand-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: clamp(0.75rem, 1vw, 0.95rem);
    color: var(--cream);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 16px;
    opacity: 0.9;
  }

  .audio-btn {
    position: absolute;
    bottom: 35px;
    left: 45px;
    background: rgba(28, 27, 26, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--cream);
    padding: 10px 18px;
    border-radius: 4px;
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    z-index: 20;
  }

  .audio-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .audio-btn.playing {
    border-color: var(--pure-white);
    background: rgba(255, 255, 255, 0.1);
  }

  .menu-overlay {
    position: absolute;
    inset: 0;
    background: rgba(24, 23, 22, 0.94);
    backdrop-filter: blur(14px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-inner-grid {
    width: 100%;
    max-width: 900px;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .menu-header-left {
    display: flex;
    flex-direction: column;
  }

  .menu-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(249, 248, 246, 0.5);
    margin-bottom: 8px;
  }

  .menu-header-left h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--pure-white);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .menu-links li {
    width: 100%;
    text-align: right;
    transform: translateY(15px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .menu-overlay.active .menu-links li {
    transform: translateY(0);
    opacity: 1;
  }

  .menu-overlay.active .menu-links li:nth-child(1) { transition-delay: 0.05s; }
  .menu-overlay.active .menu-links li:nth-child(2) { transition-delay: 0.1s; }
  .menu-overlay.active .menu-links li:nth-child(3) { transition-delay: 0.15s; }
  .menu-overlay.active .menu-links li:nth-child(4) { transition-delay: 0.2s; }
  .menu-overlay.active .menu-links li:nth-child(5) { transition-delay: 0.25s; }

  .menu-links a {
    display: block;
    padding: 12px 0;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.2vw, 2.2rem);
    color: var(--cream);
    text-decoration: none;
    letter-spacing: 0.08em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.3s ease, letter-spacing 0.3s ease, border-color 0.3s ease;
  }

  .menu-links a span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .menu-links a:hover {
    color: var(--pure-white);
    letter-spacing: 0.14em;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .close-btn {
    position: absolute;
    top: 40px;
    right: 50px;
    background: none;
    border: none;
    color: var(--cream);
    font-size: 2.5rem;
    cursor: pointer;
    font-family: 'Jost', sans-serif;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 20;
  }

  .close-btn:hover {
    opacity: 1;
  }
</style>