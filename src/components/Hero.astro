---
<section id="corporate" class="relative pt-28 pb-16 md:pt-48 md:pb-32 bg-neutral-950 text-white px-4 md:px-6 overflow-hidden w-full max-w-full">
  
  <!-- Blurred Background Image & Overlay -->
  <div class="absolute inset-0 z-0 w-full h-full overflow-hidden pointer-events-none">
    <img 
      src="/IMG_9119.JPG" 
      alt="Melissa Minnaar-Matthews Photography Background" 
      class="w-full h-full object-cover filter blur-md opacity-30 grayscale scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/70 to-neutral-950"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center w-full">
    <div class="w-full">
      <div class="mb-6 md:mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold tracking-widest text-white uppercase leading-tight break-words">
          MINNAAR-MATTHEWS
        </h2>
        <span class="font-serif text-lg md:text-2xl italic text-neutral-300 lowercase block mt-1 pl-1">
          photography
        </span>
      </div>

      <p class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-neutral-400 mb-3 md:mb-4">
        Commercial & Executive Photography
      </p>
      
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-light tracking-tight leading-tight mb-6 break-words">
        Precision lighting for <span class="font-bold underline decoration-neutral-700">corporates & brands.</span>
      </h1>
      
      <p class="text-neutral-400 text-sm md:text-lg max-w-lg leading-relaxed">
        Specializing in executive headshots, corporate culture campaigns, and high-end studio portraiture with seamless mobile on-site capabilities.
      </p>
    </div>
    
    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-3 sm:gap-4 w-full">
      <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 p-4 sm:p-6">
        <p class="text-2xl sm:text-3xl font-light text-white mb-1">100%</p>
        <p class="text-[10px] sm:text-xs text-neutral-400 uppercase tracking-wider">On-Site Mobile Studio</p>
      </div>
      <div class="bg-neutral-900/80 backdrop-blur-sm border border-neutral-800 p-4 sm:p-6">
        <p class="text-2xl sm:text-3xl font-light text-white mb-1">24-48h</p>
        <p class="text-[10px] sm:text-xs text-neutral-400 uppercase tracking-wider">Fast Turnaround</p>
      </div>
    </div>
  </div>
</section>