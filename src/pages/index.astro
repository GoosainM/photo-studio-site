---
// index.astro for Minnaar-Matthews | Creative House
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Jost:wght@400;500&display=swap" rel="stylesheet">
    <title>Minnaar-Matthews | Creative House</title>
  </head>
  <body class="bg-[#1C1B1A] text-[#F4F1EA] m-0 p-0 overflow-hidden">
    <main class="w-screen h-screen">
      <section id="hero" class="relative w-full h-full flex flex-col items-center justify-center overflow-hidden m-0 p-4">
        
        <!-- Background Image Layer with Dark Overlay -->
        <div class="absolute inset-0 z-0">
          <img 
            src="/bg.png.jpeg" 
            alt="Background" 
            class="w-full h-full object-cover object-center"
          />
          <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
        </div>

        <!-- Active Wrapper Button linking to WhatsApp -->
        <a 
          href="https://wa.me/27817586537?text=Hi%20Melissa!%20I'd%20like%20to%20enquire%20about%20booking%20a%20photography%20session." 
          target="_blank" 
          rel="noopener noreferrer"
          id="stage" 
          class="stage group relative z-10"
          aria-label="Book Session on WhatsApp"
        >
          <div class="bg-card"></div>
          <div class="plaque" id="plaque">
            <div class="glass"></div>
            <div class="monogram">
              <span class="glyph">M</span>
              <span class="divider"></span>
              <span class="glyph">M</span>
            </div>
            <div class="wordmark-bar"><span>MINNAAR&nbsp;-&nbsp;MATTHEWS</span></div>
            <div class="tagline">CREATIVE HOUSE</div>
            <div class="cta-badge">Click to Book Session →</div>
          </div>
        </a>

        <div class="hint relative z-10">Move your cursor to tilt • Click to Book</div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --ink: #1C1B1A;
    --cream: #F4F1EA;
    --border-beige: #C5BCAB;
  }

  .stage {
    position: relative;
    display: block;
    width: 100%;
    max-width: 900px;
    height: 58vh;
    max-height: 420px;
    perspective: 1600px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
    text-decoration: none;
    cursor: pointer;
  }

  .bg-card {
    position: absolute;
    inset: 0;
    background-color: rgba(28, 27, 26, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(244, 241, 234, 0.2);
    border-radius: 6px;
  }

  .plaque {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 86%;
    height: 80%;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
    background: linear-gradient(135deg, rgba(244, 241, 234, 0.08) 0%, rgba(244, 241, 234, 0.02) 100%);
    border: 1px solid rgba(244, 241, 234, 0.25);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: idleFloat 7s ease-in-out infinite;
    transition: border-color 0.3s ease;
  }

  .stage:hover .plaque {
    border-color: rgba(244, 241, 234, 0.5);
  }

  .glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
    pointer-events: none;
  }

  .monogram {
    display: flex;
    align-items: center;
    gap: 14px;
    transform: translateZ(40px);
  }

  .glyph {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    color: var(--cream);
    letter-spacing: -0.02em;
    text-shadow: 0 4px 16px rgba(0,0,0,0.6);
  }

  .divider {
    width: 2px;
    height: 34px;
    background: rgba(244, 241, 234, 0.4);
  }

  .wordmark-bar {
    margin-top: 8px;
    transform: translateZ(25px);
  }

  .wordmark-bar span {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: clamp(0.55rem, 1vw, 0.8rem);
    letter-spacing: 0.35em;
    color: var(--cream);
    opacity: 0.95;
  }

  .tagline {
    margin-top: 4px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: clamp(0.45rem, 0.8vw, 0.65rem);
    letter-spacing: 0.5em;
    color: #D3CBC0;
    transform: translateZ(15px);
  }

  .cta-badge {
    margin-top: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--border-beige);
    padding: 5px 12px;
    border-radius: 2px;
    transform: translateZ(30px);
    opacity: 0;
    transition: opacity 0.3s ease, background 0.3s ease;
  }

  .stage:hover .cta-badge {
    opacity: 1;
    background: #E8E4DC;
  }

  .hint {
    margin-top: 20px;
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(244, 241, 234, 0.6);
    text-transform: uppercase;
    pointer-events: none;
  }

  @keyframes idleFloat {
    0%, 100% { transform: translate(-50%, -50%) rotateX(0deg) rotateY(0deg); }
    50% { transform: translate(-50%, -50%) rotateX(4deg) rotateY(-6deg); }
  }
</style>

<script>
  const stage = document.getElementById('stage');
  const plaque = document.getElementById('plaque');
  let raf: number | null = null;

  function handleMove(e: MouseEvent) {
    if (!stage || !plaque) return;
    const rect = stage.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    const rotY = (x - 0.5) * 26;
    const rotX = (0.5 - y) * 18;
    
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      plaque.style.animation = 'none';
      plaque.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) translate(-50%, -50%)`;
    });
  }

  function resetTilt() {
    if (!plaque) return;
    plaque.style.transform = '';
    void plaque.offsetWidth;
    plaque.style.animation = 'idleFloat 7s ease-in-out infinite';
  }

  stage?.addEventListener('mousemove', handleMove);
  stage?.addEventListener('mouseleave', resetTilt);
</script>