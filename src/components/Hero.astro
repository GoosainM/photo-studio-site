---
// Hero Component with Full-Screen Menu
---
<div class="relative w-screen h-screen flex flex-col justify-center items-center text-center overflow-hidden">
  
  <!-- Background Image Overlay -->
  <div class="absolute inset-0 z-1 bg-cover bg-center filter grayscale contrast-125 opacity-15" style="background-image: url('/hero-bg.png');"></div>
  
  <!-- Dark Backdrop -->
  <div class="absolute inset-0 z-2 bg-black/85"></div>

  <!-- Navigation Menu Links -->
  <nav class="relative z-10 flex flex-col gap-6 items-center">
    <a href="/" class="font-['Playfair_Display'] text-3xl md:text-4xl text-[#F4F1EA] no-underline tracking-widest transition-opacity hover:opacity-70">Home</a>
    <a href="/about" class="font-['Playfair_Display'] text-3xl md:text-4xl text-[#F4F1EA] no-underline tracking-widest transition-opacity hover:opacity-70">About Us</a>
    <a href="/portfolio" class="font-['Playfair_Display'] text-3xl md:text-4xl text-[#F4F1EA] no-underline tracking-widest transition-opacity hover:opacity-70">Portfolio</a>
    <a href="/review" class="font-['Playfair_Display'] text-3xl md:text-4xl text-[#F4F1EA] no-underline tracking-widest transition-opacity hover:opacity-70">Review</a>
    <a href="/contact" class="font-['Playfair_Display'] text-3xl md:text-4xl text-[#F4F1EA] no-underline tracking-widest transition-opacity hover:opacity-70">Contact</a>
  </nav>

</div>