---
// Contact / Inquiries Page - Minnaar-Matthews Creative House
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inquiries & Bookings | Minnaar-Matthews</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body style="background-color: #F5F2EB; color: #2C2A29; font-family: 'Jost', sans-serif; margin: 0; min-height: 100vh; display: flex; flex-direction: column;">
    
    <!-- Fixed Atmospheric Background Visual -->
    <div style="position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: 0.15; background-image: url('/hero-bg.png'); background-size: cover; background-position: center; filter: grayscale(100%) contrast(125%);"></div>

    <!-- Header Navigation -->
    <header style="position: relative; z-index: 10; padding: 2rem 3rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(227, 222, 212, 0.8); background-color: rgba(245, 242, 235, 0.9);">
      <a href="/" style="font-family: 'Playfair Display', serif; letter-spacing: 0.2em; font-size: 1.125rem; text-transform: uppercase; color: #2C2A29; text-decoration: none; font-weight: bold;">Minnaar-Matthews</a>
      <div style="display: flex; gap: 2rem; align-items: center;">
        <span style="font-size: 0.75rem; letter-spacing: 0.35em; text-transform: uppercase; color: #7A756D;">Get in Touch</span>
        <a href="/" style="font-size: 0.75rem; letter-spacing: 0.35em; text-transform: uppercase; color: #2C2A29; text-decoration: none;">&larr; Home</a>
      </div>
    </header>

    <!-- Main Content Area -->
    <main style="position: relative; z-index: 10; flex-grow: 1; width: 100%; max-width: 45rem; margin: 0 auto; padding: 5rem 2rem 8rem 2rem; box-sizing: border-box;">
      
      <!-- Page Title Section -->
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span style="font-size: 0.75rem; letter-spacing: 0.4em; text-transform: uppercase; color: #7A756D; display: block; margin-bottom: 0.75rem;">Reservations & Collaboration</span>
        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 400; letter-spacing: 0.05em; text-transform: uppercase; color: #2C2A29; margin: 0;">Inquiries & Bookings</h1>
        <div style="width: 3rem; height: 1px; background-color: #C5BEB0; margin: 1.5rem auto 0 auto;"></div>
      </div>

      <!-- Form Card Container -->
      <div style="background-color: rgba(235, 230, 218, 0.85); backdrop-filter: blur(12px); border: 1px solid #DDD6C8; padding: 3rem 2.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
        <form action="#" method="POST" style="display: flex; flex-direction: column; gap: 1.75rem;">
          
          <!-- Full Name Field -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label for="name" style="font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #5C5750; font-weight: 500;">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="Enter your full name" style="background-color: rgba(255,255,255,0.6); border: 1px solid #DDD6C8; padding: 0.875rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.95rem; color: #2C2A29; outline: none; transition: border-color 0.2s;" />
          </div>

          <!-- Email Address Field -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label for="email" style="font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #5C5750; font-weight: 500;">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="Enter your email address" style="background-color: rgba(255,255,255,0.6); border: 1px solid #DDD6C8; padding: 0.875rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.95rem; color: #2C2A29; outline: none;" />
          </div>

          <!-- WhatsApp / Phone Number Field -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label for="phone" style="font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #5C5750; font-weight: 500;">WhatsApp / Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="+27..." style="background-color: rgba(255,255,255,0.6); border: 1px solid #DDD6C8; padding: 0.875rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.95rem; color: #2C2A29; outline: none;" />
          </div>

          <!-- Service / Series Interest Dropdown -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label for="service" style="font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #5C5750; font-weight: 500;">Service / Series Interest</label>
            <select id="service" name="service" style="background-color: rgba(255,255,255,0.6); border: 1px solid #DDD6C8; padding: 0.875rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.95rem; color: #2C2A29; outline: none;">
              <option value="architectural">Architectural & Spatial Series</option>
              <option value="digital">Digital Architecture & Web Development</option>
              <option value="photography">Bespoke Visual Arts & Photography</option>
              <option value="general">General Creative Consultation</option>
            </select>
          </div>

          <!-- Project Details / Message Textarea -->
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label for="message" style="font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: #5C5750; font-weight: 500;">Project Details / Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="Describe your vision, timeline, or inquiry scope..." style="background-color: rgba(255,255,255,0.6); border: 1px solid #DDD6C8; padding: 0.875rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.95rem; color: #2C2A29; outline: none; resize: vertical;"></textarea>
          </div>

          <!-- Submit Button -->
          <div style="padding-top: 0.5rem; text-align: center;">
            <button type="submit" style="background-color: #2C2A29; color: #F5F2EB; border: none; padding: 1.125rem 2.5rem; font-family: 'Jost', sans-serif; font-size: 0.75rem; letter-spacing: 0.35em; text-transform: uppercase; cursor: pointer; transition: background-color 0.2s; width: 100%;">
              Send Inquiry
            </button>
          </div>

        </form>
      </div>

    </main>

    <!-- Footer -->
    <footer style="position: relative; z-index: 10; padding: 2rem 3rem; text-align: center; font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; border-top: 1px solid #E3DED4; color: #7A756D; background-color: rgba(245, 242, 235, 0.9);">
      &copy; 2026 Minnaar-Matthews Creative House. All Rights Reserved.
    </footer>

  </body>
</html>