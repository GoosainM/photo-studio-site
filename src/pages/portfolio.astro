---
// Portfolio Page - Minnaar-Matthews Creative House
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | Minnaar-Matthews</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-[#F5F2EB] text-[#2C2A29] font-sans min-h-screen flex flex-col selection:bg-[#2C2A29] selection:text-[#F5F2EB]">
    
    <!-- Header Navigation -->
    <header class="px-12 py-8 flex justify-between items-center border-b border-[#E3DED4]">
      <a href="/" class="font-serif tracking-[0.2em] text-lg uppercase text-[#2C2A29] no-underline font-bold">Minnaar-Matthews</a>
      <a href="/" class="font-sans text-xs tracking-[0.35em] uppercase hover:opacity-60 transition-opacity text-[#2C2A29]">&larr; Back to Home</a>
    </header>

    <!-- Main Portfolio Content -->
    <main class="flex-grow max-w-7xl mx-auto px-6 py-20 w-full">
      <div class="text-center mb-16">
        <span class="font-sans text-xs tracking-[0.4em] uppercase text-[#7A756D] block mb-3">Curated Visual Archival</span>
        <h1 class="font-serif text-4xl md:text-6xl font-normal tracking-wide uppercase text-[#2C2A29]">Portfolio</h1>
        <div class="w-12 h-[1px] bg-[#C5BEB0] mx-auto mt-6"></div>
      </div>

      <!-- Strict 3-Column Side-by-Side Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 w-full">
        
        <!-- Tile 1 -->
        <div class="bg-[#EBE6DA] border border-[#DDD6C8] flex flex-col overflow-hidden p-6 shadow-sm">
          <div class="w-full h-64 overflow-hidden relative mb-6 bg-[#DFD9CC]">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1000&auto=format&fit=crop" alt="Architectural & Interior Series" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <span class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#7A756D] block mb-2">Architectural Study</span>
              <h3 class="font-serif text-xl tracking-wide mb-3 font-medium text-[#2C2A29]">Spatial Elegance</h3>
              <p class="font-sans text-sm text-[#5C5750] leading-relaxed font-light">Precision lighting and modern structural composition capturing high-end architectural design lines.</p>
            </div>
            <div class="mt-8 pt-4 border-t border-[#DFD9CC] flex justify-between items-center text-xs tracking-widest uppercase text-[#2C2A29]">
              <span>Explore Series</span>
              <span>&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Tile 2 -->
        <div class="bg-[#EBE6DA] border border-[#DDD6C8] flex flex-col overflow-hidden p-6 shadow-sm">
          <div class="w-full h-64 overflow-hidden relative mb-6 bg-[#DFD9CC]">
            <img src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=1000&auto=format&fit=crop" alt="Editorial Portraiture" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <span class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#7A756D] block mb-2">Editorial Direction</span>
              <h3 class="font-serif text-xl tracking-wide mb-3 font-medium text-[#2C2A29]">Atmospheric Portraiture</h3>
              <p class="font-sans text-sm text-[#5C5750] leading-relaxed font-light">Curated studio visual narratives centered around mood, organic texture, and refined aesthetic storytelling.</p>
            </div>
            <div class="mt-8 pt-4 border-t border-[#DFD9CC] flex justify-between items-center text-xs tracking-widest uppercase text-[#2C2A29]">
              <span>Explore Series</span>
              <span>&rarr;</span>
            </div>
          </div>
        </div>

        <!-- Tile 3 -->
        <div class="bg-[#EBE6DA] border border-[#DDD6C8] flex flex-col overflow-hidden p-6 shadow-sm">
          <div class="w-full h-64 overflow-hidden relative mb-6 bg-[#DFD9CC]">
            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=1000&auto=format&fit=crop" alt="Commercial Digital Showcase" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
          <div class="flex flex-col flex-grow justify-between">
            <div>
              <span class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#7A756D] block mb-2">Commercial Showcase</span>
              <h3 class="font-serif text-xl tracking-wide mb-3 font-medium text-[#2C2A29]">Bespoke Craft & Scale</h3>
              <p class="font-sans text-sm text-[#5C5750] leading-relaxed font-light">Custom digital branding, high-end client showcases, and tailored interactive visual presentations.</p>
            </div>
            <div class="mt-8 pt-4 border-t border-[#DFD9CC] flex justify-between items-center text-xs tracking-widest uppercase text-[#2C2A29]">
              <span>Explore Series</span>
              <span>&rarr;</span>
            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="px-12 py-8 text-center text-xs tracking-[0.3em] uppercase border-t border-[#E3DED4] text-[#7A756D]">
      &copy; 2026 Minnaar-Matthews Creative House. All Rights Reserved.
    </footer>

  </body>
</html>
