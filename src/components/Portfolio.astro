---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const categories = [
  {
    id: "corporate",
    name: "Birthday Photoshoots",
    cover: "/IMG_4392.jpg",
    images: [
      "/IMG_4392.jpg",
      "/IMG_4187.jpg",
      "/IMG_4157.jpg"
    ]
  },
  {
    id: "editorial",
    name: "Family Photoshoots",
    cover: "/IMG_0661.jpg",
    images: [
      "/IMG_0784.jpg",
      "/IMG_0661.jpg",
      "/IMG_0713.jpg"
    ]
  },
  {
    id: "studio",
    name: "Portfolio Portraits",
    cover: "/IMG_9104.JPG",
    images: [
      "/IMG_9104.JPG",
      "/IMG_9119.JPG",
      "/IMG_9131.JPG"
    ]
  }
];
---

<section id="portfolio" class="py-20 bg-neutral-950 text-white px-6 border-t border-neutral-900">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-neutral-400 mb-2">Portfolio</p>
        <h2 class="font-serif text-3xl md:text-5xl font-bold tracking-tight">Featured Categories</h2>
      </div>
      <p class="text-xs text-neutral-500 font-mono uppercase tracking-wider">
        Click card or drag to advance →
      </p>
    </div>

    <!-- 3 Category Cards Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {categories.map((cat, index) => (
        <div class="bg-neutral-900 border border-neutral-800 rounded-sm overflow-hidden flex flex-col">
          
          <!-- Swiper Container for this Category -->
          <div class={`swiper category-swiper-${index} w-full aspect-[4/5] relative group cursor-pointer select-none`}>
            <div class="swiper-wrapper">
              {cat.images.map((imgUrl) => (
                <div class="swiper-slide h-full w-full">
                  <img 
                    src={imgUrl} 
                    alt={cat.title} 
                    class="w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>

            <!-- Slide Overlay info -->
            <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/90 via-black/40 to-transparent p-6 pointer-events-none">
              <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 block mb-1">
                {cat.images.length} Photos
              </span>
              <h3 class="font-serif text-xl font-bold text-white tracking-wide">
                {cat.title}
              </h3>
              <p class="text-xs text-neutral-400 mt-1">{cat.tagline}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Client Script: Manual Click & Drag Only -->
<script>
  import Swiper from 'swiper';

  document.addEventListener('DOMContentLoaded', () => {
    [0, 1, 2].forEach((idx) => {
      const swiperInstance = new Swiper(`.category-swiper-${idx}`, {
        loop: true,
        grabCursor: true,
        allowTouchMove: true, // Allows dragging / swiping manually
      });

      // Advance to next image when clicking anywhere on the card
      const element = document.querySelector(`.category-swiper-${idx}`);
      if (element) {
        element.addEventListener('click', () => {
          swiperInstance.slideNext();
        });
      }
    });
  });
</script>