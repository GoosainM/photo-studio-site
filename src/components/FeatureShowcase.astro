---
// Interactive Feature Showcase Component - Minnaar-Matthews
---

<section class="w-full max-w-7xl mx-auto px-6 py-24">
  <div class="text-center mb-16">
    <span class="font-sans text-xs tracking-[0.4em] uppercase text-[#7A756D] block mb-3">Interactive Exploration</span>
    <h2 class="font-serif text-4xl md:text-6xl font-normal tracking-wide uppercase text-[#2C2A29]">Take a closer look.</h2>
    <div class="w-12 h-[1px] bg-[#C5BEB0] mx-auto mt-6"></div>
  </div>

  <!-- Main Showcase Container -->
  <div class="bg-[#EBE6DA]/80 backdrop-blur-md border border-[#DDD6C8] p-8 md:p-12 shadow-sm rounded-none grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Left Column: Interactive Navigation & Details -->
    <div class="lg:col-span-5 flex flex-col space-y-4">
      
      <!-- Feature 1 Button -->
      <button 
        class="feature-btn text-left p-5 transition-all duration-300 border border-transparent bg-[#DFD9CC]/60 hover:bg-[#DFD9CC] cursor-pointer group active-tab" 
        data-index="0"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-serif text-xl tracking-wide font-medium text-[#2C2A29]">Architectural Study</span>
          <span class="text-xs tracking-widest uppercase text-[#7A756D] group-hover:text-[#2C2A29] transition-colors">&rarr;</span>
        </div>
        <p class="feature-desc font-sans text-sm text-[#5C5750] leading-relaxed font-light">
          Precision lighting and modern structural composition capturing high-end architectural design lines and spatial elegance.
        </p>
      </button>

      <!-- Feature 2 Button -->
      <button 
        class="feature-btn text-left p-5 transition-all duration-300 border border-transparent bg-transparent hover:bg-[#DFD9CC]/50 cursor-pointer group" 
        data-index="1"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-serif text-xl tracking-wide font-medium text-[#2C2A29]">Editorial Direction</span>
          <span class="text-xs tracking-widest uppercase text-[#7A756D] group-hover:text-[#2C2A29] transition-colors">&rarr;</span>
        </div>
        <p class="feature-desc font-sans text-sm text-[#5C5750] leading-relaxed font-light hidden">
          Curated studio visual narratives centered around mood, organic texture, and refined aesthetic storytelling.
        </p>
      </button>

      <!-- Feature 3 Button -->
      <button 
        class="feature-btn text-left p-5 transition-all duration-300 border border-transparent bg-transparent hover:bg-[#DFD9CC]/50 cursor-pointer group" 
        data-index="2"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-serif text-xl tracking-wide font-medium text-[#2C2A29]">Digital Architecture</span>
          <span class="text-xs tracking-widest uppercase text-[#7A756D] group-hover:text-[#2C2A29] transition-colors">&rarr;</span>
        </div>
        <p class="feature-desc font-sans text-sm text-[#5C5750] leading-relaxed font-light hidden">
          Full-stack web applications, custom e-commerce architecture, and lightning-fast digital performance.
        </p>
      </button>

      <!-- Feature 4 Button -->
      <button 
        class="feature-btn text-left p-5 transition-all duration-300 border border-transparent bg-transparent hover:bg-[#DFD9CC]/50 cursor-pointer group" 
        data-index="3"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-serif text-xl tracking-wide font-medium text-[#2C2A29]">Bespoke Craft</span>
          <span class="text-xs tracking-widest uppercase text-[#7A756D] group-hover:text-[#2C2A29] transition-colors">&rarr;</span>
        </div>
        <p class="feature-desc font-sans text-sm text-[#5C5750] leading-relaxed font-light hidden">
          Tailored branding, high-end client showcases, and interactive visual presentations crafted with precision.
        </p>
      </button>

    </div>

    <!-- Right Column: Dynamic Visual Showcase Display -->
    <div class="lg:col-span-7 w-full h-[400px] md:h-[500px] relative overflow-hidden bg-[#DFD9CC] border border-[#DDD6C8] shadow-inner">
      
      <!-- Image 1 -->
      <div class="showcase-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-100">
        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop" alt="Architectural Study" class="w-full h-full object-cover filter contrast-105" />
        <div class="absolute bottom-6 left-6 bg-[#F5F2EB]/90 backdrop-blur-sm px-4 py-2 border border-[#DDD6C8] text-[10px] tracking-[0.3em] uppercase text-[#2C2A29]">
          Series 01 // Spatial Elegance
        </div>
      </div>

      <!-- Image 2 -->
      <div class="showcase-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 pointer-events-none">
        <img src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=1200&auto=format&fit=crop" alt="Editorial Direction" class="w-full h-full object-cover filter contrast-105" />
        <div class="absolute bottom-6 left-6 bg-[#F5F2EB]/90 backdrop-blur-sm px-4 py-2 border border-[#DDD6C8] text-[10px] tracking-[0.3em] uppercase text-[#2C2A29]">
          Series 02 // Atmospheric Portraiture
        </div>
      </div>

      <!-- Image 3 -->
      <div class="showcase-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 pointer-events-none">
        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=1200&auto=format&fit=crop" alt="Digital Architecture" class="w-full h-full object-cover filter contrast-105" />
        <div class="absolute bottom-6 left-6 bg-[#F5F2EB]/90 backdrop-blur-sm px-4 py-2 border border-[#DDD6C8] text-[10px] tracking-[0.3em] uppercase text-[#2C2A29]">
          Series 03 // Full-Stack Code & Scale
        </div>
      </div>

      <!-- Image 4 -->
      <div class="showcase-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 pointer-events-none">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=1200&auto=format&fit=crop" alt="Bespoke Craft" class="w-full h-full object-cover filter contrast-105" />
        <div class="absolute bottom-6 left-6 bg-[#F5F2EB]/90 backdrop-blur-sm px-4 py-2 border border-[#DDD6C8] text-[10px] tracking-[0.3em] uppercase text-[#2C2A29]">
          Series 04 // Bespoke Brand Craft
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.feature-btn');
    const images = document.querySelectorAll('.showcase-img');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const index = btn.getAttribute('data-index');

        buttons.forEach(b => {
          b.classList.remove('bg-[#DFD9CC]', 'border-[#C5BEB0]');
          b.classList.add('bg-transparent', 'border-transparent');
          const desc = b.querySelector('.feature-desc');
          if (desc) desc.classList.add('hidden');
        });

        btn.classList.remove('bg-transparent', 'border-transparent');
        btn.classList.add('bg-[#DFD9CC]', 'border-[#C5BEB0]');
        const activeDesc = btn.querySelector('.feature-desc');
        if (activeDesc) activeDesc.classList.remove('hidden');

        images.forEach((img, imgIndex) => {
          if (imgIndex.toString() === index) {
            img.classList.remove('opacity-0', 'pointer-events-none');
            img.classList.add('opacity-100');
          } else {
            img.classList.remove('opacity-100');
            img.classList.add('opacity-0', 'pointer-events-none');
          }
        });
      });
    });
  });
</script>
