---
// src/layouts/BaseLayout.astro
const { title = "Minnaar-Matthews | Creative House" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;1,300&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="editorial-home">
      <div class="ambient-backdrop"></div>

      <div class="home-container">
        <header class="home-top-bar">
          <span class="meta-tag">Maison &bull; Haute Collection</span>
          <span class="meta-location">Cape Town, South Africa</span>
        </header>

        <main class="home-hero-content">
          <slot />
        </main>

        <nav class="home-navigation">
          <span class="index-label">Directory // Index</span>
          <ul class="home-menu">
            <li><a href="/" class:list={["nav-link", { active: currentPath === "/" }]}>
              <span class="num">01</span><span class="text">Home</span>
            </a></li>
            <li><a href="/about" class:list={["nav-link", { active: currentPath.includes("about") }]}>
              <span class="num">02</span><span class="text">About Us</span>
            </a></li>
            <li><a href="/portfolio" class:list={["nav-link", { active: currentPath.includes("portfolio") }]}>
              <span class="num">03</span><span class="text">Portfolio</span>
            </a></li>
            <li><a href="/review" class:list={["nav-link", { active: currentPath.includes("review") }]}>
              <span class="num">04</span><span class="text">Review</span>
            </a></li>
            <li><a href="/contact" class:list={["nav-link", { active: currentPath.includes("contact") }]}>
              <span class="num">05</span><span class="text">Contact</span>
            </a></li>
          </ul>
        </nav>

        <footer class="home-footer">
          <audio id="bgAudio" loop preload="auto">
            <source src="/ambient.mp3" type="audio/mpeg" />
          </audio>
          <button class="audio-trigger" id="audioToggle" aria-label="Toggle Audio">
            <span class="audio-dot"></span>
            <span id="audioText">Soundscape: Off</span>
          </button>
        </footer>
      </div>
    </div>

    <script>
      const audio = document.getElementById('bgAudio') as HTMLAudioElement;
      const audioToggle = document.getElementById('audioToggle');
      const audioText = document.getElementById('audioText');
      let isPlaying = false;

      audioToggle?.addEventListener('click', () => {
        if (isPlaying) {
          audio.pause();
          if(audioText) audioText.textContent = 'Soundscape: Off';
          audioToggle.classList.remove('playing');
          isPlaying = false;
        } else {
          audio.volume = 0.3; 
          audio.play().then(() => {
            if(audioText) audioText.textContent = 'Soundscape: Active';
            audioToggle.classList.add('playing');
            isPlaying = true;
          }).catch(err => {
            console.log("Audio play failed:", err);
          });
        }
      });
    </script>

    <style>
      :root {
        --color-cotton-bg: #F7F5F0;
        --color-obsidian: #141312;
        --color-charcoal: #3A3835;
        --color-muted: #7E7870;
        --color-border: rgba(20, 19, 18, 0.12);
      }

      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        background-color: var(--color-cotton-bg);
        color: var(--color-obsidian);
        font-family: 'Jost', sans-serif;
      }

      .editorial-home {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        min-height: 100dvh;
        background-color: var(--color-cotton-bg);
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      .ambient-backdrop {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.8) 0%, rgba(247, 245, 240, 1) 75%);
        pointer-events: none;
        z-index: 0;
      }

      .home-container {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 5vh 8vw;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
      }

      .home-top-bar {
        display: flex;
        justify-content: space-between;
        font-size: 0.65rem;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 20px;
      }

      .home-hero-content {
        margin: 8vh 0;
      }

      .home-navigation {
        border-top: 1px solid var(--color-border);
        padding-top: 30px;
        margin-bottom: 40px;
      }

      .index-label {
        font-size: 0.65rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--color-muted);
        display: block;
        margin-bottom: 20px;
      }

      .home-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 4vw;
        flex-wrap: wrap;
      }

      .nav-link {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        text-decoration: none;
      }

      .nav-link .num {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        color: var(--color-muted);
        transition: color 0.3s ease;
      }

      .nav-link .text {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        letter-spacing: 0.1em;
        color: var(--color-charcoal);
        opacity: 0.7;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .nav-link:hover .text, .nav-link.active .text {
        opacity: 1;
        color: var(--color-obsidian);
        letter-spacing: 0.15em;
      }

      .nav-link:hover .num, .nav-link.active .num {
        color: var(--color-obsidian);
      }

      .home-footer {
        border-top: 1px solid var(--color-border);
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
      }

      .audio-trigger {
        background: transparent;
        border: 1px solid rgba(20, 19, 18, 0.2);
        color: var(--color-obsidian);
        padding: 10px 20px;
        font-family: 'Jost', sans-serif;
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .audio-dot {
        width: 6px;
        height: 6px;
        background-color: var(--color-muted);
        border-radius: 50%;
        transition: background-color 0.3s ease;
      }

      .audio-trigger.playing .audio-dot {
        background-color: #2e7d32;
        box-shadow: 0 0 8px rgba(46, 125, 50, 0.4);
      }

      .audio-trigger:hover {
        border-color: rgba(20, 19, 18, 0.45);
        background: rgba(20, 19, 18, 0.03);
      }

      @media(max-width: 992px) {
        .home-menu {
          flex-direction: column;
          gap: 16px;
        }
        .home-container {
          padding: 30px 20px;
        }
      }
    </style>
  </body>
</html>