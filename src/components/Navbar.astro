---
// Navbar.astro for Minnaar-Matthews Creative House
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#F4F1EA]/90 backdrop-blur-md border-b border-[#C5BCAB]/40 w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    
    <!-- IMAGE LOGO -->
    <a href="#" class="flex items-center">
      <img 
        src="/logo.png" 
        alt="Minnaar-Matthews Creative House Logo" 
        class="h-10 md:h-12 w-auto object-contain"
      />
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-[#5A5348]">
      <a href="#corporate" class="hover:text-[#1C1B1A] transition-colors">About us</a>
      <a href="#portfolio" class="hover:text-[#1C1B1A] transition-colors">Portfolio</a>
      <a href="#reviews" class="hover:text-[#1C1B1A] transition-colors">Reviews</a>
      <a href="#contact" class="hover:text-[#1C1B1A] transition-colors">Contact Us</a>
    </nav>

    <!-- WHATSAPP BOOK SESSION BUTTON -->
    <a 
      href="https://wa.me/27817586537?text=Hi%20Melissa!%20I'd%20like%20to%20enquire%20about%20booking%20a%20photography%20session." 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-[#E8E4DC] border border-[#C5BCAB] text-[#1C1B1A] text-xs font-semibold uppercase tracking-wider px-4 py-2.5 hover:bg-[#DCD7CD] transition-colors rounded-sm shadow-sm"
    >
      Book Session
    </a>
  </div>
</header>