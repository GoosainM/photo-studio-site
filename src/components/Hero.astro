---
// Hero.astro for Minnaar-Matthews Creative House
---

<section id="hero" class="relative w-full mt-20 bg-[#F4F1EA] flex items-center justify-center overflow-hidden" style="height: 70vh;">
  <div class="w-full h-full flex items-center justify-center p-4">
    <img 
      src="/hero-bg.png" 
      alt="Minnaar-Matthews Creative House Showcase" 
      class="object-contain object-center shadow-sm"
      style="width: auto; height: auto; max-width: 85%; max-height: 75vh;"
    />
  </div>
</section>

<style>
  @media (min-width: 768px) {
    #hero {
      height: 85vh;
    }
  }
</style>