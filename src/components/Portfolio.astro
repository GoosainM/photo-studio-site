---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const categories = [
  {
    id: "corporate",
    title: "Birthday Photoshoots",
    tagline: "Capturing milestone moments and celebrations",
    cover: "/IMG_4392.jpg",
    images: [
      "/IMG_4392.jpg",
      "/IMG_4187.jpg",
      "/IMG_4157.jpg"
    ]
  },
  {
    id: "editorial",
    title: "Family Photoshoots",
    tagline: "Timeless portraits of connection and warmth",
    cover: "/IMG_0661.jpg",
    images: [
      "/IMG_0784.jpg",
      "/IMG_0661.jpg",
      "/IMG_0713.jpg"
    ]
  },
  {
    id: "studio",
    title: "Portfolio Portraits",
    tagline: "Striking editorial and creative styling",
    cover: "/IMG_9104.JPG",
    images: [
      "/IMG_9104.JPG",
      "/IMG_9119.JPG",
      "/IMG_9131.JPG"
    ]
  }
];
---

<section id="portfolio" class="py-16 bg-[#F4F1EA] text-[#1C1B1A] px-4 md:px-12 border-t border-[#C5BCAB]/40">
  <div class="max-w-7xl mx-auto w-full">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
      <div>
        <p class="text-[10px] font-mono uppercase tracking-widest text-[#6B6354] mb-1">Portfolio</p>
        <h2 class="font-serif text-2xl md:text-4xl font-light tracking-tight text-[#1C1B1A]">Featured Categories</h2>
      </div>
      <p class="text-[10px] text-[#6B6354] font-mono uppercase tracking-wider">
        Click card or drag to advance →
      </p>
    </div>

    <!-- 3 Category Cards Grid with controlled height -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categories.map((cat, index) => (
        <div class="bg-[#E8E4DC] border border-[#C5BCAB]/60 rounded-sm overflow-hidden flex flex-col shadow-sm">
          
          <!-- Swiper Container with strict max height -->
          <div class={`swiper category-swiper-${index} w-full h-[350px] md:h-[400px] relative group cursor-pointer select-none`}>
            <div class="swiper-wrapper w-full h-full">
              {cat.images.map((imgUrl) => (
                <div class="swiper-slide h-full w-full flex items-center justify-center overflow-hidden">
                  <img 
                    src={imgUrl} 
                    alt={cat.title} 
                    class="w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>

            <!-- Slide Overlay info -->
            <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[#1C1B1A]/90 via-[#1C1B1A]/40 to-transparent p-5 pointer-events-none">
              <span class="text-[9px] font-mono uppercase tracking-widest text-[#C5BCAB] block mb-1">
                {cat.images.length} Photos
              </span>
              <h3 class="font-serif text-lg font-bold text-[#F4F1EA] tracking-wide">
                {cat.title}
              </h3>
              <p class="text-xs text-[#E8E4DC]/80 mt-0.5">{cat.tagline}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Client Script -->
<script>
  import Swiper from 'swiper';

  document.addEventListener('DOMContentLoaded', () => {
    [0, 1, 2].forEach((idx) => {
      const swiperInstance = new Swiper(`.category-swiper-${idx}`, {
        loop: true,
        grabCursor: true,
        allowTouchMove: true,
      });

      const element = document.querySelector(`.category-swiper-${idx}`);
      if (element) {
        element.addEventListener('click', () => {
          swiperInstance.slideNext();
        });
      }
    });
  });
</script>