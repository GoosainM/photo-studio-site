---
// Immersive Visual Portfolio & Collections - Minnaar-Matthews Creative House
import BaseLayouts from '../layouts/BaseLayouts.astro';
---

<BaseLayouts title="Visual Portfolio & Collections | Minnaar-Matthews">
  <div class="portfolio-page">
    
    <!-- Hero Intro Banner -->
    <section class="portfolio-hero">
      <span class="subhead-mono">Curated Visual Archive</span>
      <h1 class="hero-title">Visual Portfolio &amp; Collections</h1>
      <div class="divider-line"></div>
      <p class="hero-description">
        Explore our curated collections across photography, brand strategy, commercial content creation, and high-impact social design.
      </p>
      <div class="scroll-indicator">
        Scroll To Explore &darr;
      </div>
    </section>

    <!-- Visual Portfolio Collections Grid -->
    <main class="collections-container">
      <div class="collections-grid">

        <!-- 01. Photography Collection -->
        <article class="collection-card">
          <div class="card-visual">
            <img 
              src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&w=1200&q=80" 
              alt="Photography Collection" 
              class="card-img"
            />
            <div class="card-overlay"></div>
            <span class="card-num">01</span>
          </div>
          <div class="card-content">
            <span class="card-meta">Editorial &amp; Architectural Photography</span>
            <h2 class="card-title">Photography Collection</h2>
            <p class="card-desc">
              High-end editorial framing, architectural compositions, and character portraiture capturing lighting precision and atmospheric depth.
            </p>
            <a href="/contact" class="card-link">View Gallery &rarr;</a>
          </div>
        </article>

        <!-- 02. Brand Collection -->
        <article class="collection-card">
          <div class="card-visual">
            <img 
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80" 
              alt="Brand Collection" 
              class="card-img"
            />
            <div class="card-overlay"></div>
            <span class="card-num">02</span>
          </div>
          <div class="card-content">
            <span class="card-meta">Identity Systems &amp; Guidelines</span>
            <h2 class="card-title">Brand Collection</h2>
            <p class="card-desc">
              Bespoke visual identity systems, typographic hierarchies, and cohesive brand guidelines designed to establish market authority.
            </p>
            <a href="/contact" class="card-link">Explore Identity &rarr;</a>
          </div>
        </article>

        <!-- 03. Content Collection -->
        <article class="collection-card">
          <div class="card-visual">
            <img 
              src="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1200&q=80" 
              alt="Content Collection" 
              class="card-img"
            />
            <div class="card-overlay"></div>
            <span class="card-num">03</span>
          </div>
          <div class="card-content">
            <span class="card-meta">Cinematic Production &amp; Commercial Assets</span>
            <h2 class="card-title">Content Collection</h2>
            <p class="card-desc">
              Short-form video assets, commercial lifestyle imagery, and narrative visual campaigns tailored for modern digital platforms.
            </p>
            <a href="/contact" class="card-link">View Media &rarr;</a>
          </div>
        </article>

        <!-- 04. Social Media Design Collection -->
        <article class="collection-card">
          <div class="card-visual">
            <img 
              src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80" 
              alt="Social Media Design Collection" 
              class="card-img"
            />
            <div class="card-overlay"></div>
            <span class="card-num">04</span>
          </div>
          <div class="card-content">
            <span class="card-meta">Digital Campaigns &amp; Editorial Feeds</span>
            <h2 class="card-title">Social Media Design Collection</h2>
            <p class="card-desc">
              Custom social layouts, promotional graphics, and curated editorial grid systems engineered to elevate online brand engagement.
            </p>
            <a href="/contact" class="card-link">Explore Designs &rarr;</a>
          </div>
        </article>

      </div>
    </main>

  </div>
</BaseLayouts>

<style>
  .portfolio-page {
    background-color: #F5F2EB;
    color: #2C2A29;
    font-family: 'Jost', sans-serif;
    min-height: 100vh;
    padding-bottom: 6rem;
  }

  /* Hero Banner */
  .portfolio-hero {
    height: 60vh;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 2rem 1.5rem;
    margin-top: 2rem;
  }

  .subhead-mono {
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #7A756D;
    display: block;
    margin-bottom: 1rem;
    font-family: monospace;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #2C2A29;
    margin: 0 0 1.5rem 0;
  }

  .divider-line {
    width: 3rem;
    height: 1px;
    background-color: #C5BEB0;
    margin: 0 auto 1.5rem auto;
  }

  .hero-description {
    font-size: 0.95rem;
    font-weight: 300;
    color: #5C5750;
    letter-spacing: 0.04em;
    max-width: 34rem;
    line-height: 1.7;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    color: #7A756D;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-family: monospace;
  }

  /* Collections Layout */
  .collections-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }

  /* Collection Cards */
  .collection-card {
    background-color: #FAF7F2;
    border: 1px solid #E3DED4;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(44, 42, 41, 0.06);
  }

  .card-visual {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: hidden;
    background-color: #E5E2DC;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .collection-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44, 42, 41, 0.4) 0%, transparent 60%);
  }

  .card-num {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-family: monospace;
    font-size: 0.85rem;
    color: #FAF7F2;
    background: rgba(44, 42, 41, 0.6);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .card-content {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .card-meta {
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #8C6D43;
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.65rem;
    font-weight: 500;
    color: #2C2A29;
    margin: 0 0 0.85rem 0;
    line-height: 1.25;
  }

  .card-desc {
    font-size: 0.875rem;
    color: #5C5750;
    line-height: 1.65;
    font-weight: 300;
    margin-bottom: 1.75rem;
  }

  .card-link {
    display: inline-block;
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #3B151A;
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid #3B151A;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .card-link:hover {
    color: #8C6D43;
    border-color: #8C6D43;
  }
</style>