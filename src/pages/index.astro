---
// index.astro for Minnaar-Matthews | Creative House
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Jost:wght@400;500&display=swap" rel="stylesheet">
    <title>Minnaar-Matthews | Creative House</title>
  </head>
  <body class="bg-[#0d0d0c] text-[#f6f4ef] m-0 p-0 overflow-x-hidden">
    <main>
      <section id="hero" class="relative w-full h-screen bg-[#0d0d0c] flex items-center justify-center overflow-hidden m-0 p-0">
        <div id="stage" class="stage">
          <div class="bg"></div>
          <div class="plaque" id="plaque">
            <div class="glass"></div>
            <div class="monogram">
              <span class="glyph">M</span>
              <span class="divider"></span>
              <span class="glyph">M</span>
            </div>
            <div class="wordmark-bar"><span>MINNAAR&nbsp;-&nbsp;MATTHEWS</span></div>
            <div class="tagline">CREATIVE HOUSE</div>
          </div>
        </div>
        <div class="hint">Move your cursor to tilt the logo</div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --ink: #1b1b1a;
    --cream: #f6f4ef;
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 851/315;
    margin: 24px;
    perspective: 1600px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-color: #1b1b1a;
  }

  .plaque {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 82%;
    height: 76%;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
    background: linear-gradient(135deg, rgba(246, 244, 239, 0.08) 0%, rgba(246, 244, 239, 0.02) 100%);
    border: 1px solid rgba(246, 244, 239, 0.2);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: idleFloat 7s ease-in-out infinite;
  }

  .glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.05) 50%, transparent 100%);
    pointer-events: none;
  }

  .monogram {
    display: flex;
    align-items: center;
    gap: 16px;
    transform: translateZ(40px);
  }

  .glyph {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--cream);
    letter-spacing: -0.02em;
    text-shadow: 0 10px 20px rgba(0,0,0,0.5);
  }

  .divider {
    width: 2px;
    height: 40px;
    background: rgba(246, 244, 239, 0.4);
  }

  .wordmark-bar {
    margin-top: 10px;
    transform: translateZ(25px);
  }

  .wordmark-bar span {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: clamp(0.6rem, 1.2vw, 0.9rem);
    letter-spacing: 0.35em;
    color: var(--cream);
    opacity: 0.9;
  }

  .tagline {
    margin-top: 6px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: clamp(0.5rem, 0.9vw, 0.7rem);
    letter-spacing: 0.5em;
    color: #c5bcab;
    transform: translateZ(15px);
  }

  .hint {
    position: absolute;
    bottom: 30px;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: rgba(246, 244, 239, 0.4);
    text-transform: uppercase;
    pointer-events: none;
  }

  @keyframes idleFloat {
    0%, 100% { transform: translate(-50%, -50%) rotateX(0deg) rotateY(0deg); }
    50% { transform: translate(-50%, -50%) rotateX(4deg) rotateY(-6deg); }
  }
</style>

<script>
  const stage = document.getElementById('stage');
  const plaque = document.getElementById('plaque');
  let raf: number | null = null;

  function handleMove(e: MouseEvent) {
    if (!stage || !plaque) return;
    const rect = stage.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    const y = (e.clientY - rect.top) / rect.height;
    const rotY = (x - 0.5) * 26;
    const rotX = (0.5 - y) * 18;
    
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      plaque.style.animation = 'none';
      plaque.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) translate(-50%, -50%)`;
    });
  }

  function resetTilt() {
    if (!plaque) return;
    plaque.style.transform = '';
    void plaque.offsetWidth;
    plaque.style.animation = 'idleFloat 7s ease-in-out infinite';
  }

  stage?.addEventListener('mousemove', handleMove);
  stage?.addEventListener('mouseleave', resetTilt);
</script>