---
// src/components/Hero.astro
---

<div class="page-container">
  <!-- Background Image -->
  <div class="bg"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>

  <!-- Main Editorial Content Area -->
  <div class="content-wrapper">
    <div class="brand-block">
      <div class="brand-badge-wrapper">
        <span class="chic-badge">Maison &bull; Est. Studio</span>
      </div>
      <h1 class="brand-name">Minnaar-<br/><span class="italic-text">Matthews</span></h1>
      <p class="brand-sub">Creative House &mdash; Modern Architectural &amp; Digital Design</p>
    </div>
  </div>

  <!-- Timeless Classy Editorial Sidebar -->
  <aside class="sidebar-menu">
    <div class="sidebar-header">
      <span class="sidebar-subtitle">Index / Nav</span>
      <h3>Directory</h3>
    </div>
    <ul class="sidebar-links">
      <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span>01. Home</span></a></li>
      <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span>02. About Us</span></a></li>
      <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span>03. Portfolio</span></a></li>
      <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span>04. Review</span></a></li>
      <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span>05. Contact</span></a></li>
    </ul>

    <!-- Audio Player Footer -->
    <div class="sidebar-footer">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-btn" id="audioToggle" aria-label="Toggle Audio">
        <svg class="sound-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.5" fill="none">
          <path class="speaker" d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path class="wave1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="audioText">Sound: Off</span>
      </button>
    </div>
  </aside>
</div>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Sound: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.3; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Sound: On';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      if (window.innerWidth > 768) {
        const targetId = link.getAttribute('data-target');
        bannerLayers.forEach(banner => {
          if (banner.id === targetId) {
            banner.classList.add('active');
          } else {
            banner.classList.remove('active');
          }
        });
      }
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelector('.sidebar-links')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --champagne: #E3DDD5;
    --pure-white: #FFFFFF;
    --obsidian: #0A0A09;
    --surface-glass: rgba(14, 13, 12, 0.65);
  }

  .page-container {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background-color: var(--obsidian);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.85) contrast(110%);
    z-index: 0;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.9) contrast(135%);
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.85;
  }

  /* Modern Classy Left Content Block */
  .content-wrapper {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    padding-left: 12vw;
    padding-right: 4vw;
  }

  .brand-block {
    width: 100%;
    max-width: 620px;
    padding: 60px 50px;
    background: var(--surface-glass);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(227, 221, 213, 0.15);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .chic-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.45em;
    color: var(--champagne);
    opacity: 0.8;
    display: inline-block;
    border-bottom: 1px solid rgba(227, 221, 213, 0.3);
    padding-bottom: 6px;
    margin-bottom: 24px;
  }

  .brand-name {
    font-family: 'Playfair Display', serif;
    font-weight: 300;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    color: var(--pure-white);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.1;
    margin: 0;
  }

  .brand-name .italic-text {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--champagne);
  }

  .brand-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--champagne);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin-top: 28px;
    opacity: 0.85;
  }

  /* Timeless Classy Sidebar */
  .sidebar-menu {
    position: relative;
    z-index: 10;
    width: 400px;
    min-height: 100vh;
    background: rgba(10, 10, 9, 0.96);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-left: 1px solid rgba(227, 221, 213, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 70px 50px;
  }

  .sidebar-header {
    border-bottom: 1px solid rgba(227, 221, 213, 0.1);
    padding-bottom: 22px;
  }

  .sidebar-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(227, 221, 213, 0.45);
    margin-bottom: 6px;
    display: block;
  }

  .sidebar-header h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--pure-white);
    letter-spacing: 0.1em;
    margin: 0;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 40px 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-links a {
    display: block;
    padding: 4px 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--champagne);
    text-decoration: none;
    letter-spacing: 0.12em;
    opacity: 0.7;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar-links a:hover {
    color: var(--pure-white);
    opacity: 1;
    letter-spacing: 0.18em;
    transform: translateX(6px);
  }

  .sidebar-footer {
    border-top: 1px solid rgba(227, 221, 213, 0.1);
    padding-top: 24px;
  }

  .audio-btn {
    background: transparent;
    border: 1px solid rgba(227, 221, 213, 0.2);
    color: var(--champagne);
    padding: 12px 18px;
    border-radius: 0px;
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    width: 100%;
    transition: all 0.35s ease;
  }

  .audio-btn:hover {
    background: rgba(227, 221, 213, 0.08);
    border-color: rgba(227, 221, 213, 0.45);
    color: var(--pure-white);
  }

  .audio-btn.playing {
    border-color: var(--pure-white);
    background: rgba(227, 221, 213, 0.05);
    color: var(--pure-white);
  }

  /* Responsive Layout Adjustments */
  @media(max-width: 900px) {
    .page-container {
      flex-direction: column;
      height: auto;
    }

    .content-wrapper {
      padding: 60px 20px;
      justify-content: center;
    }

    .brand-block {
      padding: 40px 24px;
    }

    .sidebar-menu {
      width: 100%;
      min-height: auto;
      border-left: none;
      border-top: 1px solid rgba(227, 221, 213, 0.1);
      padding: 40px 24px;
    }

    .sidebar-links {
      margin: 25px 0;
      gap: 16px;
    }
  }
</style>