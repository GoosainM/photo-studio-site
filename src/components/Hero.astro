---
// src/components/Hero.astro
---

<section class="editorial-stage">
  <!-- Background Image & Atmospheric Grain -->
  <div class="bg-asset"></div>
  <div class="vignette-overlay"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>

  <!-- Main Editorial Canvas -->
  <div class="canvas-main">
    <div class="editorial-header-meta">
      <span class="meta-tag">Maison &bull; Vol. 01</span>
      <span class="meta-location">Cape Town</span>
    </div>

    <div class="brand-signature">
      <h1 class="brand-title">
        Minnaar<span class="separator">&mdash;</span><br />
        <span class="italic-surname">Matthews</span>
      </h1>
      <p class="brand-caption">Creative Architecture &bull; Digital Haute Couture</p>
    </div>
  </div>

  <!-- Minimalist High-End Sidebar -->
  <nav class="editorial-sidebar">
    <div class="sidebar-top">
      <span class="index-label">Index // Directory</span>
    </div>

    <ul class="editorial-menu">
      <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span class="num">01</span><span class="text">Home</span></a></li>
      <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span class="num">02</span><span class="text">About Us</span></a></li>
      <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span class="num">03</span><span class="text">Portfolio</span></a></li>
      <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span class="num">04</span><span class="text">Review</span></a></li>
      <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span class="num">05</span><span class="text">Contact</span></a></li>
    </ul>

    <!-- Audio Player Footer -->
    <div class="sidebar-bottom">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-trigger" id="audioToggle" aria-label="Toggle Audio">
        <span class="audio-dot"></span>
        <span id="audioText">Soundscape: Off</span>
      </button>
    </div>
  </nav>
</section>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Soundscape: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.3; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Soundscape: Active';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      if (window.innerWidth > 768) {
        const targetId = link.getAttribute('data-target');
        bannerLayers.forEach(banner => {
          if (banner.id === targetId) {
            banner.classList.add('active');
          } else {
            banner.classList.remove('active');
          }
        });
      }
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelector('.editorial-menu')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --color-bg: #0C0B0A;
    --color-ivory: #F4F1EA;
    --color-muted: #9E9A92;
    --color-white: #FFFFFF;
  }

  /* Global Lockdown to Prevent Horizontal Scrollbars */
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    background-color: var(--color-bg);
    color: var(--color-ivory);
    font-family: 'Jost', sans-serif;
  }

  .editorial-stage {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .bg-asset {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.8) contrast(105%);
    z-index: 0;
  }

  .vignette-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(12,11,10,0.2) 0%, rgba(12,11,10,0.85) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.9) contrast(130%);
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.85;
  }

  /* Main Canvas Area */
  .canvas-main {
    position: relative;
    z-index: 4;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5vh 5vw;
    pointer-events: none;
  }

  .editorial-header-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .brand-signature {
    max-width: 700px;
  }

  .brand-title {
    font-family: 'Playfair Display', serif;
    font-weight: 300;
    font-size: clamp(2.8rem, 6.5vw, 5.5rem);
    color: var(--color-white);
    line-height: 1.05;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  .brand-title .separator {
    color: var(--color-muted);
    font-weight: 200;
    margin: 0 10px;
  }

  .brand-title .italic-surname {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-ivory);
  }

  .brand-caption {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 2rem;
  }

  /* High-End Editorial Sidebar */
  .editorial-sidebar {
    position: relative;
    z-index: 10;
    width: 360px;
    height: 100%;
    background: rgba(12, 11, 10, 0.92);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border-left: 1px solid rgba(244, 241, 234, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 60px 45px;
  }

  .sidebar-top {
    border-bottom: 1px solid rgba(244, 241, 234, 0.08);
    padding-bottom: 20px;
  }

  .index-label {
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .editorial-menu {
    list-style: none;
    padding: 0;
    margin: auto 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .nav-link {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    text-decoration: none;
    padding: 4px 0;
  }

  .nav-link .num {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    transition: color 0.3s ease;
  }

  .nav-link .text {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    color: var(--color-ivory);
    opacity: 0.7;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover .text {
    opacity: 1;
    color: var(--color-white);
    letter-spacing: 0.16em;
    transform: translateX(6px);
  }

  .nav-link:hover .num {
    color: var(--color-white);
  }

  .sidebar-bottom {
    border-top: 1px solid rgba(244, 241, 234, 0.08);
    padding-top: 24px;
  }

  .audio-trigger {
    background: transparent;
    border: 1px solid rgba(244, 241, 234, 0.15);
    color: var(--color-ivory);
    padding: 12px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .audio-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-muted);
    border-radius: 50%;
    transition: background-color 0.3s ease;
  }

  .audio-trigger.playing .audio-dot {
    background-color: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.5);
  }

  .audio-trigger:hover {
    border-color: rgba(244, 241, 234, 0.4);
    background: rgba(244, 241, 234, 0.04);
  }

  /* Responsive Breakpoints */
  @media(max-width: 992px) {
    .editorial-stage {
      flex-direction: column;
      height: auto;
      min-height: 100vh;
    }

    .canvas-main {
      min-height: 55vh;
      padding: 40px 24px;
    }

    .editorial-sidebar {
      width: 100%;
      height: auto;
      border-left: none;
      border-top: 1px solid rgba(244, 241, 234, 0.08);
      padding: 40px 24px;
    }

    .editorial-menu {
      margin: 30px 0;
      gap: 18px;
    }
  }
</style>