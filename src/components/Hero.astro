---
// src/components/Hero.astro
---

<div class="page-container">
  <!-- Background Image -->
  <div class="bg"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>

  <!-- Main Content Area -->
  <div class="content-wrapper">
    <div class="brand-block">
      <span class="chic-badge">Studio Collection</span>
      <h1 class="brand-name">Minnaar-Matthews</h1>
      <p class="brand-sub">Creative House &bull; Pure Design</p>
    </div>
  </div>

  <!-- Side Bar Menu -->
  <aside class="sidebar-menu">
    <div class="sidebar-header">
      <span class="sidebar-subtitle">Index</span>
      <h3>Navigation</h3>
    </div>
    <ul class="sidebar-links">
      <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span>01. Home</span></a></li>
      <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span>02. About Us</span></a></li>
      <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span>03. Portfolio</span></a></li>
      <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span>04. Review</span></a></li>
      <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span>05. Contact</span></a></li>
    </ul>

    <!-- Audio Player inside Sidebar Footer -->
    <div class="sidebar-footer">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-btn" id="audioToggle" aria-label="Toggle Audio">
        <svg class="sound-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
          <path class="speaker" d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path class="wave1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="audioText">Sound: Off</span>
      </button>
    </div>
  </aside>
</div>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Sound: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.35; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Sound: On';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      const targetId = link.getAttribute('data-target');
      bannerLayers.forEach(banner => {
        if (banner.id === targetId) {
          banner.classList.add('active');
        } else {
          banner.classList.remove('active');
        }
      });
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelector('.sidebar-links')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --cream: #F9F8F6;
    --pure-white: #FFFFFF;
    --charcoal: #1C1B1A;
  }

  .page-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    overflow: hidden;
    background-color: var(--charcoal);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.85) contrast(105%);
    z-index: 0;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.95) contrast(125%);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.85;
  }

  /* Left Main Content Layout */
  .content-wrapper {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    padding-left: 8vw;
    pointer-events: none;
  }

  .brand-block {
    max-width: 650px;
    padding: 50px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(28, 27, 26, 0.4);
    backdrop-filter: blur(16px);
  }

  .chic-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--cream);
    margin-bottom: 16px;
    opacity: 0.8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    display: inline-block;
    padding-bottom: 4px;
  }

  .brand-name {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 4rem);
    color: var(--pure-white);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .brand-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: clamp(0.75rem, 1vw, 0.95rem);
    color: var(--cream);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 16px;
    opacity: 0.9;
  }

  /* Fixed Right Side Bar Menu */
  .sidebar-menu {
    position: relative;
    z-index: 10;
    width: 380px;
    height: 100%;
    background: rgba(20, 19, 18, 0.92);
    backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 60px 40px;
  }

  .sidebar-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 24px;
  }

  .sidebar-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(249, 248, 246, 0.5);
    margin-bottom: 6px;
    display: block;
  }

  .sidebar-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: var(--pure-white);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: auto 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-links a {
    display: block;
    padding: 8px 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--cream);
    text-decoration: none;
    letter-spacing: 0.08em;
    transition: color 0.3s ease, letter-spacing 0.3s ease;
  }

  .sidebar-links a span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .sidebar-links a:hover {
    color: var(--pure-white);
    letter-spacing: 0.14em;
  }

  .sidebar-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
  }

  .audio-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--cream);
    padding: 10px 16px;
    border-radius: 4px;
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    justify-content: center;
  }

  .audio-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .audio-btn.playing {
    border-color: var(--pure-white);
    background: rgba(255, 255, 255, 0.1);
  }

  @media(max-width: 900px) {
    .page-container {
      flex-direction: column;
      overflow-y: auto;
      height: auto;
    }
    .sidebar-menu {
      width: 100%;
      height: auto;
      padding: 40px 20px;
    }
    .content-wrapper {
      padding: 60px 20px;
    }
  }
</style>