---
// src/pages/index.astro
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Minnaar-Matthews | Creative House</title>
    
    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8LSLBVDXXL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8LSLBVDXXL');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="editorial-wrapper">
      
      <!-- Top Architectural Header Bar -->
      <header class="top-bar">
        <div class="top-bar-left">
          <span class="mono-tag">[ M&mdash;M ]</span>
          <span class="location-tag">Cape Town, ZA</span>
        </div>
        <div class="top-bar-center">
          <span class="house-title">Minnaar-Matthews Creative House</span>
        </div>
        <div class="top-bar-right">
          <a href="#contact" class="top-cta-link">Inquire &rarr;</a>
        </div>
      </header>

      <main class="main-content">

        <!-- SECTION 01: HERO / MONOGRAM -->
        <section id="home" class="hero-section">
          <div class="hero-grid">
            <div class="hero-image-pane">
              <img src="/bg.jpeg" alt="Editorial Visual" class="hero-bg-img" />
              <div class="image-overlay-vignette"></div>
            </div>

            <div class="hero-typography-pane">
              <div class="monogram-container">
                <div class="monogram-m">M</div>
                <div class="monogram-divider"></div>
                <div class="monogram-m">M</div>
              </div>

              <div class="hero-copy-block">
                <span class="eyebrow-label">Volume I / Edition 2026</span>
                <h1 class="hero-statement">Visual Identity &amp; Digital Architecture</h1>
                <p class="hero-manifesto-text">
                  A bespoke creative suite dedicated to refining brand presence through tailored digital experiences, editorial photography, and purposeful design.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 02: ABOUT / STATEMENT -->
        <section id="about" class="editorial-section about-section">
          <div class="section-column-left">
            <span class="section-index">01.0</span>
            <h2 class="section-label">Manifesto</h2>
          </div>

          <div class="section-column-right">
            <p class="about-headline">
              We design for those who value quiet authority over loud convention.
            </p>
            
            <div class="about-body-text">
              <p>
                Created for small businesses, entrepreneurs, and visionaries who demand authenticity and precision. Your brand is not merely a logo or a product—it is an enduring narrative.
              </p>
              <p>
                From structural branding and content curation to high-resolution portraiture and digital platforms, we engineer visuals that speak with absolute clarity.
              </p>
            </div>

            <div class="triad-statement">
              <div class="triad-col"><span>01</span> Structure</div>
              <div class="triad-col"><span>02</span> Story</div>
              <div class="triad-col"><span>03</span> Elevation</div>
            </div>
          </div>
        </section>

        <!-- SECTION 03: WORKS / COLLECTIONS LIST (Interactive Index) -->
        <section id="portfolio" class="editorial-section portfolio-section">
          <div class="portfolio-header">
            <div class="portfolio-title-group">
              <span class="section-index">02.0</span>
              <h2 class="section-label">Selected Collections</h2>
            </div>
            <p class="portfolio-subtext">Hover or tap to reveal collection preview</p>
          </div>

          <div class="collections-list">
            <!-- Collection Item 1 -->
            <article class="collection-row" data-bg="/IMG_0661.jpg">
              <div class="row-num">01</div>
              <div class="row-title-block">
                <h3 class="collection-title">Photography Collection</h3>
                <span class="collection-type">Editorial &amp; Portraiture</span>
              </div>
              <div class="row-arrow">&nearr;</div>
              <div class="row-hover-preview">
                <img src="/IMG_0661.jpg" alt="Photography Collection Preview" loading="lazy" />
              </div>
            </article>

            <!-- Collection Item 2 -->
            <article class="collection-row" data-bg="/IMG_0713.jpg">
              <div class="row-num">02</div>
              <div class="row-title-block">
                <h3 class="collection-title">Brand Collection</h3>
                <span class="collection-type">Identity &amp; Strategy</span>
              </div>
              <div class="row-arrow">&nearr;</div>
              <div class="row-hover-preview">
                <img src="/IMG_0713.jpg" alt="Brand Collection Preview" loading="lazy" />
              </div>
            </article>

            <!-- Collection Item 3 -->
            <article class="collection-row" data-bg="/IMG_0784.jpg">
              <div class="row-num">03</div>
              <div class="row-title-block">
                <h3 class="collection-title">Content Collection</h3>
                <span class="collection-type">Visual Storytelling &amp; Media</span>
              </div>
              <div class="row-arrow">&nearr;</div>
              <div class="row-hover-preview">
                <img src="/IMG_0784.jpg" alt="Content Collection Preview" loading="lazy" />
              </div>
            </article>

            <!-- Collection Item 4 -->
            <article class="collection-row" data-bg="/bg.jpeg">
              <div class="row-num">04</div>
              <div class="row-title-block">
                <h3 class="collection-title">Social Media Design</h3>
                <span class="collection-type">Digital Curation &amp; Layout</span>
              </div>
              <div class="row-arrow">&nearr;</div>
              <div class="row-hover-preview">
                <img src="/bg.jpeg" alt="Social Media Design Preview" loading="lazy" />
              </div>
            </article>
          </div>
        </section>

        <!-- SECTION 04: PRIVATE VAULT / GALLERIES -->
        <section id="gallery" class="editorial-section vault-section">
          <div class="section-column-left">
            <span class="section-index">03.0</span>
            <h2 class="section-label">Private Vault</h2>
          </div>

          <div class="section-column-right">
            <p class="vault-intro">
              Enter your access key to unlock high-resolution deliverables and raw client proofs.
            </p>

            <div class="vault-access-container">
              <form id="gallery-form" class="vault-form">
                <div class="vault-input-wrap">
                  <input type="password" id="gallery-code" required autocomplete="new-password" placeholder="ENTER ACCESS CODE..." class="vault-input" />
                  <button type="submit" class="vault-submit-btn">
                    <span>Unlock</span>
                    <span class="btn-arrow">&rarr;</span>
                  </button>
                </div>
                <p id="gallery-error" class="vault-error-msg">Invalid Passcode or Vault Expired.</p>
              </form>

              <!-- Dynamic Gallery Display View -->
              <div id="gallery-content-view" class="vault-content-hidden">
                <div class="vault-success-header">
                  <div>
                    <span class="vault-status-tag">[ Vault Status: Authenticated ]</span>
                    <h3 class="vault-client-title" id="gallery-title-text">Client Access Granted</h3>
                  </div>
                  <button type="button" id="gallery-lock-btn" class="vault-lock-btn">Lock Session</button>
                </div>
                <div class="vault-images-grid" id="client-images-container">
                  <!-- Dynamic Google Sheet images injected here -->
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 05: CONTACT / INQUIRY -->
        <section id="contact" class="editorial-section contact-section">
          <div class="section-column-left">
            <span class="section-index">04.0</span>
            <h2 class="section-label">Inquiry</h2>
          </div>

          <div class="section-column-right">
            <p class="contact-headline">
              Initiate a dialogue regarding project availability, creative direction, or visual identity builds.
            </p>

            <form action="https://api.web3forms.com/submit" method="POST" class="raw-contact-form">
              <input type="hidden" name="access_key" value="7ccd0b54-a506-45ef-85ab-4a13b570d3a3">
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

              <div class="form-row-two">
                <div class="field-block">
                  <label for="name" class="field-label">01 // Full Name</label>
                  <input type="text" id="name" name="name" required placeholder="John Doe" class="raw-input" />
                </div>
                <div class="field-block">
                  <label for="email" class="field-label">02 // Email Address</label>
                  <input type="email" id="email" name="email" required placeholder="john@domain.com" class="raw-input" />
                </div>
              </div>

              <div class="field-block">
                <label for="message" class="field-label">03 // Scope of Work / Details</label>
                <textarea id="message" name="message" rows="4" required placeholder="Provide brief summary of project requirements..." class="raw-input"></textarea>
              </div>

              <button type="submit" class="raw-submit-btn">
                <span>Send Dispatch</span>
                <span>&rarr;</span>
              </button>
            </form>
          </div>
        </section>

      </main>

      <!-- Persistent Bottom Navigation Dock -->
      <footer class="bottom-dock">
        <nav class="dock-nav">
          <a href="#home" class="dock-link active" data-target="home">Index</a>
          <span class="dock-sep">/</span>
          <a href="#about" class="dock-link" data-target="about">Manifesto</a>
          <span class="dock-sep">/</span>
          <a href="#portfolio" class="dock-link" data-target="portfolio">Collections</a>
          <span class="dock-sep">/</span>
          <a href="#gallery" class="dock-link" data-target="gallery">Vault</a>
          <span class="dock-sep">/</span>
          <a href="#contact" class="dock-link" data-target="contact">Inquire</a>
        </nav>
      </footer>

    </div>

    <script>
      // Active Nav Link Observer
      const sections = document.querySelectorAll('section');
      const navLinks = document.querySelectorAll('.dock-link');

      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
          const sectionTop = section.getBoundingClientRect().top;
          if (sectionTop <= window.innerHeight / 2) {
            current = section.getAttribute('id') || '';
          }
        });

        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('data-target') === current) {
            link.classList.add('active');
          }
        });
      });

      // SheetDB API integration for client vault access
      const SHEET_API_URL = "https://sheetdb.io/api/v1/vcnfx2ryw9sra";

      document.addEventListener('DOMContentLoaded', () => {
        const galleryForm = document.getElementById('gallery-form');
        const lockBtn = document.getElementById('gallery-lock-btn');

        if (galleryForm) {
          galleryForm.addEventListener('submit', handleGalleryAccess);
        }

        if (lockBtn) {
          lockBtn.addEventListener('click', lockGallery);
        }
      });

      async function handleGalleryAccess(event) {
        if (event) event.preventDefault();

        const inputCode = document.getElementById('gallery-code').value.trim();
        const errorMsg = document.getElementById('gallery-error');
        const formEl = document.getElementById('gallery-form');
        const contentView = document.getElementById('gallery-content-view');
        const titleText = document.getElementById('gallery-title-text');
        const imagesContainer = document.getElementById('client-images-container');
        const submitBtn = formEl.querySelector('button[type="submit"]');

        const btnSpan = submitBtn.querySelector('span');
        const originalBtnText = btnSpan.textContent;
        btnSpan.textContent = 'Verifying...';

        try {
          const response = await fetch(SHEET_API_URL);
          const rows = await response.json();

          const galleryData = rows.find(row => String(row.pin).trim() === inputCode);

          if (galleryData) {
            titleText.textContent = galleryData.title || "Private Collection";

            const imageUrls = galleryData.images ? galleryData.images.split(',').map(url => url.trim()) : [];

            imagesContainer.innerHTML = imageUrls.map((url, index) => `
              <div class="vault-image-card">
                <img src="${url}" alt="${galleryData.title} Proof 0${index + 1}" loading="lazy" />
                <a href="${url}" download class="vault-download-btn" target="_blank">Download High-Res <span>&darr;</span></a>
              </div>
            `).join('');

            errorMsg.style.display = 'none';
            formEl.style.display = 'none';
            contentView.style.display = 'block';
          } else {
            errorMsg.style.display = 'block';
          }
        } catch (err) {
          console.error("Error fetching vault data:", err);
          errorMsg.textContent = "Vault connection failure. Please retry.";
          errorMsg.style.display = 'block';
        } finally {
          btnSpan.textContent = originalBtnText;
        }

        return false;
      }

      function lockGallery() {
        document.getElementById('gallery-form').style.display = 'block';
        document.getElementById('gallery-content-view').style.display = 'none';
        document.getElementById('gallery-code').value = '';
        document.getElementById('gallery-error').style.display = 'none';
      }
    </script>

    <style>
      :root {
        --bg-paper: #F2EFE9;
        --color-black: #0E0D0D;
        --color-charcoal: #2A2826;
        --color-muted: #807B73;
        --border-stark: #0E0D0D;
        --border-subtle: rgba(14, 13, 13, 0.15);
        --font-serif: 'Playfair Display', Georgia, serif;
        --font-sans: 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background-color: var(--bg-paper);
        color: var(--color-black);
      }

      body {
        margin: 0;
        padding: 0;
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .editorial-wrapper {
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* TOP ARCHITECTURAL BAR */
      .top-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 50px;
        background-color: var(--bg-paper);
        border-bottom: 1px solid var(--border-stark);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 2rem;
        z-index: 100;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .top-bar-left {
        display: flex;
        gap: 1.5rem;
      }

      .mono-tag {
        font-weight: 500;
      }

      .location-tag {
        color: var(--color-muted);
      }

      .top-bar-center {
        text-align: center;
        font-family: var(--font-serif);
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-transform: none;
      }

      .top-bar-right {
        text-align: right;
      }

      .top-cta-link {
        color: var(--color-black);
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.2s;
      }

      .top-cta-link:hover {
        opacity: 0.6;
      }

      .main-content {
        margin-top: 50px;
        margin-bottom: 60px;
      }

      /* SECTION 01: HERO GRID */
      .hero-section {
        min-height: calc(100vh - 110px);
        border-bottom: 1px solid var(--border-stark);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        min-height: calc(100vh - 110px);
      }

      .hero-image-pane {
        position: relative;
        width: 100%;
        min-height: 50vh;
        background-color: var(--color-black);
        overflow: hidden;
      }

      .hero-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%) contrast(120%) brightness(0.8);
      }

      .hero-typography-pane {
        padding: 3rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-color: var(--bg-paper);
        border-top: 1px solid var(--border-stark);
      }

      .monogram-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .monogram-m {
        font-family: var(--font-serif);
        font-size: clamp(4rem, 12vw, 8rem);
        line-height: 0.9;
        font-weight: 400;
      }

      .monogram-divider {
        width: 1px;
        height: 60px;
        background-color: var(--border-stark);
      }

      .eyebrow-label {
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--color-muted);
        display: block;
        margin-bottom: 0.75rem;
      }

      .hero-statement {
        font-family: var(--font-serif);
        font-size: clamp(1.8rem, 4vw, 3.2rem);
        font-weight: 400;
        line-height: 1.1;
        margin: 0 0 1.5rem 0;
        text-transform: uppercase;
      }

      .hero-manifesto-text {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--color-charcoal);
        max-width: 500px;
        margin: 0;
      }

      /* EDITORIAL SECTION BASE */
      .editorial-section {
        border-bottom: 1px solid var(--border-stark);
        padding: 5rem 2rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .section-index {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: var(--color-muted);
        display: block;
        margin-bottom: 0.5rem;
      }

      .section-label {
        font-family: var(--font-serif);
        font-size: 1.8rem;
        font-weight: 400;
        margin: 0;
        text-transform: uppercase;
      }

      /* ABOUT SECTION */
      .about-headline {
        font-family: var(--font-serif);
        font-size: clamp(1.4rem, 3vw, 2.2rem);
        line-height: 1.3;
        margin: 0 0 2rem 0;
      }

      .about-body-text {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-charcoal);
      }

      .triad-statement {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--border-stark);
        margin-top: 3rem;
        padding-top: 1.5rem;
        gap: 1rem;
      }

      .triad-col {
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .triad-col span {
        color: var(--color-muted);
        display: block;
        margin-bottom: 0.25rem;
      }

      /* PORTFOLIO / COLLECTIONS LIST */
      .portfolio-section {
        display: block;
        padding: 5rem 0;
      }

      .portfolio-header {
        padding: 0 2rem 3rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-bottom: 1px solid var(--border-stark);
      }

      .portfolio-subtext {
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin: 0;
      }

      .collections-list {
        display: flex;
        flex-direction: column;
      }

      .collection-row {
        position: relative;
        display: grid;
        grid-template-columns: 60px 1fr 40px;
        align-items: center;
        padding: 2.5rem 2rem;
        border-bottom: 1px solid var(--border-subtle);
        cursor: pointer;
        transition: background-color 0.3s ease;
      }

      .collection-row:hover {
        background-color: rgba(14, 13, 13, 0.03);
      }

      .row-num {
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        color: var(--color-muted);
      }

      .collection-title {
        font-family: var(--font-serif);
        font-size: clamp(1.4rem, 3.5vw, 2.5rem);
        font-weight: 400;
        margin: 0 0 0.3rem 0;
        transition: transform 0.3s ease;
      }

      .collection-type {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .row-arrow {
        font-size: 1.5rem;
        line-height: 1;
        text-align: right;
        transition: transform 0.3s ease;
      }

      .collection-row:hover .row-arrow {
        transform: translate(5px, -5px);
      }

      /* Hover Image Drawer */
      .row-hover-preview {
        position: absolute;
        right: 10%;
        top: 50%;
        transform: translateY(-50%) scale(0.9);
        width: 220px;
        height: 150px;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
        border: 1px solid var(--border-stark);
        z-index: 10;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .row-hover-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
      }

      .collection-row:hover .row-hover-preview {
        opacity: 1;
        transform: translateY(-50%) scale(1);
      }

      /* VAULT SECTION */
      .vault-intro {
        font-size: 1rem;
        color: var(--color-charcoal);
        margin: 0 0 2rem 0;
      }

      .vault-input-wrap {
        display: flex;
        border: 1px solid var(--border-stark);
      }

      .vault-input {
        flex: 1;
        background: transparent;
        border: none;
        padding: 1.2rem;
        font-family: var(--font-sans);
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        color: var(--color-black);
        outline: none;
      }

      .vault-submit-btn {
        background-color: var(--color-black);
        color: var(--bg-paper);
        border: none;
        padding: 0 2rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: opacity 0.2s;
      }

      .vault-submit-btn:hover {
        opacity: 0.85;
      }

      .vault-error-msg {
        display: none;
        color: #922216;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        margin-top: 0.75rem;
        text-transform: uppercase;
      }

      .vault-content-hidden {
        display: none;
      }

      .vault-success-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border-stark);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }

      .vault-status-tag {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .vault-client-title {
        font-family: var(--font-serif);
        font-size: 1.8rem;
        font-weight: 400;
        margin: 0.5rem 0 0 0;
      }

      .vault-lock-btn {
        background: transparent;
        border: 1px solid var(--border-stark);
        padding: 0.6rem 1.2rem;
        font-family: var(--font-sans);
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .vault-images-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .vault-image-card {
        border: 1px solid var(--border-stark);
        padding: 1rem;
        background: #EAE6DF;
      }

      .vault-image-card img {
        width: 100%;
        height: 350px;
        object-fit: cover;
        display: block;
        margin-bottom: 1rem;
      }

      .vault-download-btn {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-black);
        text-decoration: none;
        padding-top: 0.5rem;
        border-top: 1px solid var(--border-subtle);
      }

      /* CONTACT FORM */
      .contact-headline {
        font-family: var(--font-serif);
        font-size: clamp(1.3rem, 3vw, 2rem);
        margin: 0 0 2.5rem 0;
        line-height: 1.3;
      }

      .raw-contact-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .form-row-two {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .field-block {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .field-label {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .raw-input {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--border-stark);
        padding: 0.8rem 0;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-black);
        outline: none;
        border-radius: 0;
      }

      .raw-input:focus {
        border-bottom-width: 2px;
      }

      .raw-submit-btn {
        align-self: flex-start;
        background-color: var(--color-black);
        color: var(--bg-paper);
        border: none;
        padding: 1.2rem 2.5rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        cursor: pointer;
        display: flex;
        gap: 1.5rem;
        transition: opacity 0.2s;
        margin-top: 1rem;
      }

      .raw-submit-btn:hover {
        opacity: 0.85;
      }

      /* BOTTOM DOCK */
      .bottom-dock {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background-color: var(--bg-paper);
        border-top: 1px solid var(--border-stark);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
      }

      .dock-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .dock-link {
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.2s;
      }

      .dock-link.active, .dock-link:hover {
        color: var(--color-black);
        font-weight: 500;
      }

      .dock-sep {
        color: var(--border-subtle);
      }

      /* MEDIA QUERIES (DESKTOP GRID ENHANCEMENTS) */
      @media (min-width: 900px) {
        .hero-grid {
          grid-template-columns: 1.2fr 1fr;
        }

        .hero-image-pane {
          min-height: auto;
        }

        .hero-typography-pane {
          border-top: none;
          border-left: 1px solid var(--border-stark);
          padding: 4rem 3rem;
        }

        .editorial-section {
          grid-template-columns: 240px 1fr;
          padding: 6rem 3rem;
        }

        .about-body-text {
          grid-template-columns: 1fr 1fr;
        }

        .portfolio-header {
          padding: 0 3rem 4rem 3rem;
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-end;
        }

        .collection-row {
          padding: 3rem 3rem;
        }

        .vault-images-grid {
          grid-template-columns: 1fr 1fr;
        }

        .form-row-two {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </body>
</html>