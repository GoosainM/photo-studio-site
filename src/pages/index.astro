---
// src/pages/index.astro
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Minnaar-Matthews | Creative House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;1,300&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="editorial-site">
      <div class="ambient-backdrop"></div>

      <!-- Persistent Top Header -->
      <header class="site-top-bar">
        <span class="meta-tag">Creative House Collections</span>
      </header>

      <!-- Main Scrolling Sections -->
      <main class="scroll-container">
        
        <!-- SECTION 01: HOME -->
        <section id="home" class="editorial-section home-section-hero">
          <div class="hero-bg-asset"></div>
          <div class="hero-vignette"></div>

          <div class="section-inner home-grid">
            <div class="brand-block">
              <span class="chic-badge">Pure Design Studio</span>
              <h1 class="brand-title">
                Minnaar<span class="separator">&mdash;</span><br />
                <span class="italic-surname">Matthews</span>
              </h1>
              <p class="brand-caption">Creative House &bull; Digital Precision</p>
            </div>
            <div class="intro-statement">
              <p>Curating timeless digital sanctuaries and refined brand architectures with the texture of fine Egyptian cotton and minimalist clarity.</p>
            </div>
          </div>
        </section>

        <!-- SECTION 02: ABOUT US -->
        <section id="about" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">02 &bull; About Us</span>
            <h2 class="section-heading">The Architecture of Elegance</h2>
            <p class="section-body">
              Rooted in Cape Town, Minnaar-Matthews operates at the intersection of high-end digital craftsmanship and timeless architectural minimalism. Every project is sculpted with intention, structure, and enduring grace.
            </p>
          </div>
        </section>

        <!-- SECTION 03: PORTFOLIO -->
        <section id="portfolio" class="editorial-section portfolio-section">
          <div class="section-inner">
            <span class="chic-badge">03 &bull; Portfolio</span>
            <h2 class="section-heading">Selected Works</h2>
            <p class="section-body portfolio-intro">
              A curated exhibition of digital platforms, custom e-commerce web architecture, and brand identities. Tap or click any card to reveal the exhibition piece.
            </p>

            <div class="flip-cards-grid">
              <!-- Card 1 -->
              <div class="flip-card" onclick="this.classList.toggle('flipped')">
                <div class="flip-card-inner">
                  <div class="flip-card-front">
                    <div class="card-number">01 / Collection</div>
                    <h3 class="card-title">Architectural Form</h3>
                    <p class="card-hint">Tap to Flip &rarr;</p>
                  </div>
                  <div class="flip-card-back">
                    <img src="/IMG_0661.jpg" alt="Exhibition Piece 01" loading="lazy" />
                  </div>
                </div>
              </div>

              <!-- Card 2 -->
              <div class="flip-card" onclick="this.classList.toggle('flipped')">
                <div class="flip-card-inner">
                  <div class="flip-card-front">
                    <div class="card-number">02 / Collection</div>
                    <h3 class="card-title">Spatial Harmony</h3>
                    <p class="card-hint">Tap to Flip &rarr;</p>
                  </div>
                  <div class="flip-card-back">
                    <img src="/IMG_0713.jpg" alt="Exhibition Piece 02" loading="lazy" />
                  </div>
                </div>
              </div>

              <!-- Card 3 -->
              <div class="flip-card" onclick="this.classList.toggle('flipped')">
                <div class="flip-card-inner">
                  <div class="flip-card-front">
                    <div class="card-number">03 / Collection</div>
                    <h3 class="card-title">Textural Precision</h3>
                    <p class="card-hint">Tap to Flip &rarr;</p>
                  </div>
                  <div class="flip-card-back">
                    <img src="/IMG_0784.jpg" alt="Exhibition Piece 03" loading="lazy" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 04: REVIEW -->
        <section id="review" class="editorial-section">
          <div class="section-inner">
            <span class="chic-badge">04 &bull; Review</span>
            <h2 class="section-heading">Client Reflections</h2>
            <p class="section-body">
              "Working with Minnaar-Matthews transformed our digital presence into a timeless work of art. The precision and elegance are unmatched."
            </p>
          </div>
        </section>

        <!-- SECTION 05: CONTACT -->
        <section id="contact" class="editorial-section contact-section">
          <div class="section-inner">
            <span class="chic-badge">05 &bull; Contact</span>
            <h2 class="section-heading">Initiate a Dialogue</h2>
            <p class="section-body contact-intro">
              For bespoke inquiries, architectural web builds, and creative direction, connect with our studio directly in Cape Town.
            </p>

            <form action="https://api.web3forms.com/submit" method="POST" class="editorial-contact-form">
              <!-- Web3Forms Access Key -->
              <input type="hidden" name="access_key" value="7ccd0b54-a506-45ef-85ab-4a13b570d3a3">
              
              <!-- Optional: Honeypot Spam Protection -->
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

              <div class="form-grid">
                <div class="form-group">
                  <label for="name" class="form-label">Name</label>
                  <input type="text" id="name" name="name" required class="form-input" placeholder="Your Name" />
                </div>
                <div class="form-group">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" id="email" name="email" required class="form-input" placeholder="Your Email" />
                </div>
              </div>

              <div class="form-group">
                <label for="message" class="form-label">Message</label>
                <textarea id="message" name="message" rows="4" required class="form-input" placeholder="Describe your project or inquiry..."></textarea>
              </div>

              <button type="submit" class="editorial-submit-btn">
                <span>Submit Inquiry</span>
                <span class="btn-arrow">&rarr;</span>
              </button>
            </form>
          </div>
        </section>

      </main>

      <!-- Persistent Footer Navigation & Audio -->
      <footer class="site-footer-nav">
        <nav class="home-navigation">
          <ul class="home-menu">
            <li><a href="#home" class="nav-link active" data-target="home"><span class="num">01</span><span class="text">Home</span></a></li>
            <li><a href="#about" class="nav-link" data-target="about"><span class="num">02</span><span class="text">About</span></a></li>
            <li><a href="#portfolio" class="nav-link" data-target="portfolio"><span class="num">03</span><span class="text">Work</span></a></li>
            <li><a href="#review" class="nav-link" data-target="review"><span class="num">04</span><span class="text">Review</span></a></li>
            <li><a href="#contact" class="nav-link" data-target="contact"><span class="num">05</span><span class="text">Contact</span></a></li>
          </ul>
        </nav>

        <div class="audio-footer-bar">
          <audio id="bgAudio" loop preload="auto">
            <source src="/ambient.mp3" type="audio/mpeg" />
          </audio>
          <button class="audio-trigger" id="audioToggle" aria-label="Toggle Audio">
            <span class="audio-dot"></span>
            <span id="audioText">Sound: Off</span>
          </button>
        </div>
      </footer>
    </div>

    <script>
      const audio = document.getElementById('bgAudio') as HTMLAudioElement;
      const audioToggle = document.getElementById('audioToggle');
      const audioText = document.getElementById('audioText');
      let isPlaying = false;

      audioToggle?.addEventListener('click', () => {
        if (isPlaying) {
          audio.pause();
          if(audioText) audioText.textContent = 'Sound: Off';
          audioToggle.classList.remove('playing');
          isPlaying = false;
        } else {
          audio.volume = 0.3; 
          audio.play().then(() => {
            if(audioText) audioText.textContent = 'Sound: Active';
            audioToggle.classList.add('playing');
            isPlaying = true;
          }).catch(err => {
            console.log("Audio play failed:", err);
          });
        }
      });

      const sections = document.querySelectorAll('.editorial-section');
      const navLinks = document.querySelectorAll('.nav-link');

      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
          const sectionTop = section.getBoundingClientRect().top;
          if (sectionTop <= window.innerHeight / 2) {
            current = section.getAttribute('id') || '';
          }
        });

        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('data-target') === current) {
            link.classList.add('active');
          }
        });
      });
    </script>

    <style>
      :root {
        --color-cotton-bg: #F7F5F0;     
        --color-obsidian: #141312;      
        --color-charcoal: #3A3835;      
        --color-muted: #7E7870;         
        --color-border: rgba(20, 19, 18, 0.12); 
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        background-color: var(--color-cotton-bg);
        color: var(--color-obsidian);
        font-family: 'Jost', sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .editorial-site {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        background-color: var(--color-cotton-bg);
        display: flex;
        flex-direction: column;
      }

      .ambient-backdrop {
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.8) 0%, rgba(247, 245, 240, 1) 75%);
        pointer-events: none;
        z-index: 0;
      }

      .site-top-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        padding: 16px 5vw;
        font-size: 0.55rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--color-muted);
        border-bottom: 1px solid var(--color-border);
        background: rgba(247, 245, 240, 0.95);
        backdrop-filter: blur(10px);
        z-index: 10;
      }

      .scroll-container {
        position: relative;
        z-index: 2;
        padding-top: 70px;
        padding-bottom: 90px;
      }

      .editorial-section {
        min-height: 85vh;
        display: flex;
        align-items: center;
        padding: 6vh 5vw;
        box-sizing: border-box;
        border-bottom: 1px solid var(--color-border);
      }

      /* Home Section with bg.jpeg Background */
      .home-section-hero {
        position: relative;
        overflow: hidden;
        color: #F4F1EA !important;
      }

      .hero-bg-asset {
        position: absolute;
        inset: 0;
        background-image: url('/bg.jpeg');
        background-size: cover;
        background-position: center;
        filter: brightness(0.65) contrast(110%);
        z-index: 0;
      }

      .hero-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle, rgba(12,11,10,0.3) 0%, rgba(12,11,10,0.85) 100%);
        z-index: 1;
        pointer-events: none;
      }

      .home-section-hero .section-inner {
        position: relative;
        z-index: 2;
      }

      .home-section-hero .chic-badge {
        color: #D4CEC3;
        border-bottom-color: rgba(244, 241, 234, 0.4);
      }

      .home-section-hero .brand-title {
        color: #FFFFFF;
      }

      .home-section-hero .brand-title .separator {
        color: #9E9A92;
      }

      .home-section-hero .brand-title .italic-surname {
        color: #F4F1EA;
      }

      .home-section-hero .brand-caption {
        color: #9E9A92;
      }

      .home-section-hero .intro-statement p {
        color: #E6E2D8;
      }

      .section-inner {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
      }

      .home-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: flex-start;
      }

      .chic-badge {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        color: var(--color-charcoal);
        margin-bottom: 14px;
        display: inline-block;
        border-bottom: 1px solid var(--color-charcoal);
        padding-bottom: 4px;
        opacity: 0.8;
      }

      .brand-title {
        font-family: 'Playfair Display', serif;
        font-weight: 300;
        font-size: clamp(2.4rem, 11vw, 4rem);
        color: var(--color-obsidian);
        line-height: 1.05;
        letter-spacing: 0.02em;
        margin: 0;
        text-transform: uppercase;
      }

      .brand-title .separator {
        color: var(--color-muted);
        font-weight: 200;
        margin: 0 8px;
      }

      .brand-title .italic-surname {
        font-style: italic;
        font-weight: 400;
        color: var(--color-charcoal);
      }

      .brand-caption {
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-top: 1.2rem;
      }

      .intro-statement, .section-body {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem;
        line-height: 1.5;
        color: var(--color-charcoal);
        opacity: 0.9;
        max-width: 100%;
        letter-spacing: 0.02em;
      }

      .section-heading {
        font-family: 'Playfair Display', serif;
        font-weight: 300;
        font-size: clamp(2rem, 8vw, 3rem);
        color: var(--color-obsidian);
        margin: 0 0 1rem 0;
        text-transform: uppercase;
      }

      /* Portfolio 3D Flip Cards Styling */
      .portfolio-section {
        min-height: auto;
        padding: 10vh 5vw;
      }

      .portfolio-intro {
        margin-bottom: 2.5rem;
      }

      .flip-cards-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        width: 100%;
      }

      .flip-card {
        background-color: transparent;
        width: 100%;
        height: 380px;
        perspective: 1000px;
        cursor: pointer;
      }

      .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
        transform-style: preserve-3d;
      }

      .flip-card.flipped .flip-card-inner {
        transform: rotateY(180deg);
      }

      .flip-card-front, .flip-card-back {
        position: absolute;
        inset: 0;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        border: 1px solid var(--color-border);
        box-sizing: border-box;
      }

      .flip-card-front {
        background-color: #EFECE6;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 2.5rem 2rem;
        text-align: left;
      }

      .card-number {
        font-size: 0.55rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .card-title {
        font-family: 'Playfair Display', serif;
        font-weight: 400;
        font-size: 1.8rem;
        color: var(--color-obsidian);
        margin: 0;
        line-height: 1.2;
      }

      .card-hint {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-charcoal);
        opacity: 0.7;
      }

      .flip-card-back {
        background-color: var(--color-obsidian);
        transform: rotateY(180deg);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .flip-card-back img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Contact Section Form Styles */
      .contact-section {
        min-height: auto;
        padding: 10vh 5vw;
      }

      .contact-intro {
        margin-bottom: 2rem;
        max-width: 600px;
      }

      .editorial-contact-form {
        max-width: 700px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5srem;
      }

      .form-label {
        font-size: 0.6rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--color-charcoal);
        opacity: 0.8;
      }

      .form-input {
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 0;
        padding: 14px 16px;
        font-family: 'Jost', sans-serif;
        font-size: 0.95rem;
        color: var(--color-obsidian);
        outline: none;
        transition: border-color 0.2s ease;
      }

      .form-input:focus {
        border-color: var(--color-obsidian);
      }

      .form-input::placeholder {
        color: var(--color-muted);
        opacity: 0.5;
      }

      textarea.form-input {
        resize: vertical;
        min-height: 120px;
      }

      .editorial-submit-btn {
        background-color: var(--color-obsidian);
        color: #F7F5F0;
        border: 1px solid var(--color-obsidian);
        padding: 16px 28px;
        font-family: 'Jost', sans-serif;
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 0.5rem;
        max-width: 220px;
      }

      .editorial-submit-btn:hover {
        background-color: transparent;
        color: var(--color-obsidian);
      }

      .btn-arrow {
        font-size: 1rem;
        line-height: 1;
      }

      /* Mobile-Optimized Sticky Bottom Navigation */
      .site-footer-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        background: rgba(247, 245, 240, 0.96);
        backdrop-filter: blur(12px);
        border-top: 1px solid var(--color-border);
        padding: 12px 4vw;
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 10;
      }

      .home-navigation {
        width: 100%;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: none;
      }

      .home-navigation::-webkit-scrollbar {
        display: none;
      }

      .home-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: inline-flex;
        gap: 20px;
      }

      .nav-link {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
        text-decoration: none;
        padding: 4px 0;
      }

      .nav-link .num {
        font-size: 0.55rem;
        letter-spacing: 0.1em;
        color: var(--color-muted);
      }

      .nav-link .text {
        font-family: 'Playfair Display', serif;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        color: var(--color-charcoal);
        opacity: 0.6;
        transition: all 0.2s ease;
      }

      .nav-link:hover .text, .nav-link.active .text {
        opacity: 1;
        color: var(--color-obsidian);
      }

      .nav-link:hover .num, .nav-link.active .num {
        color: var(--color-obsidian);
      }

      .audio-footer-bar {
        display: flex;
        justify-content: flex-end;
        border-top: 1px solid rgba(20, 19, 18, 0.06);
        padding-top: 6px;
      }

      .audio-trigger {
        background: transparent;
        border: 1px solid rgba(20, 19, 18, 0.2);
        color: var(--color-obsidian);
        padding: 6px 12px;
        font-family: 'Jost', sans-serif;
        font-size: 0.55rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
      }

      .audio-dot {
        width: 5px;
        height: 5px;
        background-color: var(--color-muted);
        border-radius: 50%;
        transition: background-color 0.3s ease;
      }

      .audio-trigger.playing .audio-dot {
        background-color: #2e7d32;
        box-shadow: 0 0 6px rgba(46, 125, 50, 0.4);
      }

      /* Desktop enhancements */
      @media(min-width: 992px) {
        .scroll-container {
          padding-top: 100px;
          padding-bottom: 0;
        }
        .site-footer-nav {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          padding: 20px 8vw;
        }
        .home-navigation {
          overflow-x: visible;
        }
        .home-menu {
          gap: 3vw;
        }
        .audio-footer-bar {
          border-top: none;
          padding-top: 0;
        }
        .home-grid {
          grid-template-columns: 1.2fr 0.8fr;
          gap: 4rem;
          align-items: flex-end;
        }
        .flip-cards-grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 2rem;
        }
        .flip-card {
          height: 440px;
        }
        .form-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </body>
</html>