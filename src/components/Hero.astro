---
// src/components/Hero.astro
---

<div class="page-container">
  <!-- Background Image -->
  <div class="bg"></div>
  
  <!-- Dynamic Background Hover Banners -->
  <div class="banner-layer" id="bannerHome" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerAbout" style="background-image: url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerPortfolio" style="background-image: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerReview" style="background-image: url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1920&q=80');"></div>
  <div class="banner-layer" id="bannerContact" style="background-image: url('https://images.unsplash.com/photo-1512314889357-e157c22f938d?auto=format&fit=crop&w=1920&q=80');"></div>

  <!-- Main Editorial Content Area -->
  <div class="content-wrapper">
    <div class="brand-block">
      <span class="chic-badge">Maison Collection</span>
      <h1 class="brand-name">Minnaar-<br/>Matthews</h1>
      <p class="brand-sub">Creative House &mdash; Pure Design</p>
    </div>
  </div>

  <!-- Timeless Editorial Sidebar Navigation -->
  <aside class="sidebar-menu">
    <div class="sidebar-header">
      <span class="sidebar-subtitle">Index</span>
      <h3>Navigation</h3>
    </div>
    <ul class="sidebar-links">
      <li><a href="#" class="nav-link" data-section="Home" data-target="bannerHome"><span>01. Home</span></a></li>
      <li><a href="/about" class="nav-link" data-section="About Us" data-target="bannerAbout"><span>02. About Us</span></a></li>
      <li><a href="/portfolio" class="nav-link" data-section="Portfolio" data-target="bannerPortfolio"><span>03. Portfolio</span></a></li>
      <li><a href="/review" class="nav-link" data-section="Review" data-target="bannerReview"><span>04. Review</span></a></li>
      <li><a href="/contact" class="nav-link" data-section="Contact" data-target="bannerContact"><span>05. Contact</span></a></li>
    </ul>

    <!-- Audio Player Footer -->
    <div class="sidebar-footer">
      <audio id="bgAudio" loop preload="auto">
        <source src="/ambient.mp3" type="audio/mpeg" />
      </audio>
      <button class="audio-btn" id="audioToggle" aria-label="Toggle Audio">
        <svg class="sound-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.5" fill="none">
          <path class="speaker" d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path class="wave1" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="audioText">Sound: Off</span>
      </button>
    </div>
  </aside>
</div>

<script>
  const navLinks = document.querySelectorAll('.nav-link');
  const bannerLayers = document.querySelectorAll('.banner-layer');
  
  const audio = document.getElementById('bgAudio') as HTMLAudioElement;
  const audioToggle = document.getElementById('audioToggle');
  const audioText = document.getElementById('audioText');
  let isPlaying = false;

  audioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isPlaying) {
      audio.pause();
      if(audioText) audioText.textContent = 'Sound: Off';
      audioToggle.classList.remove('playing');
      isPlaying = false;
    } else {
      audio.volume = 0.3; 
      audio.play().then(() => {
        if(audioText) audioText.textContent = 'Sound: On';
        audioToggle.classList.add('playing');
        isPlaying = true;
      }).catch(err => {
        console.log("Audio play failed:", err);
      });
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      if (window.innerWidth > 768) {
        const targetId = link.getAttribute('data-target');
        bannerLayers.forEach(banner => {
          if (banner.id === targetId) {
            banner.classList.add('active');
          } else {
            banner.classList.remove('active');
          }
        });
      }
    });

    link.addEventListener('click', (e) => {
      const section = link.getAttribute('data-section');
      if (section === 'Home') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelector('.sidebar-links')?.addEventListener('mouseleave', () => {
    bannerLayers.forEach(banner => banner.classList.remove('active'));
  });
</script>

<style>
  :root {
    --ivory: #F7F5F0;
    --pure-white: #FFFFFF;
    --obsidian: #121110;
  }

  .page-container {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow-x: hidden;
    background-color: var(--obsidian);
  }

  .bg {
    position: absolute;
    inset: 0;
    background-image: url('/bg.jpeg');
    background-size: cover;
    background-position: center;
    filter: brightness(0.9) contrast(110%);
    z-index: 0;
  }

  .banner-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.95) contrast(130%);
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    pointer-events: none;
  }

  .banner-layer.active {
    opacity: 0.88;
  }

  /* Timeless Left Content Block */
  .content-wrapper {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    align-items: center;
    padding-left: 10vw;
    padding-right: 4vw;
  }

  .brand-block {
    width: 100%;
    max-width: 580px;
    padding: 50px 45px;
    background: rgba(18, 17, 16, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(247, 245, 240, 0.12);
  }

  .chic-badge {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--ivory);
    margin-bottom: 20px;
    opacity: 0.7;
    display: inline-block;
    border-bottom: 1px solid rgba(247, 245, 240, 0.25);
    padding-bottom: 6px;
  }

  .brand-name {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    color: var(--pure-white);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    line-height: 1.15;
    margin: 0;
  }

  .brand-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--ivory);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin-top: 24px;
    opacity: 0.85;
  }

  /* Editorial Sidebar */
  .sidebar-menu {
    position: relative;
    z-index: 10;
    width: 380px;
    min-height: 100vh;
    background: rgba(15, 14, 13, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-left: 1px solid rgba(247, 245, 240, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 70px 50px;
  }

  .sidebar-header {
    border-bottom: 1px solid rgba(247, 245, 240, 0.08);
    padding-bottom: 20px;
  }

  .sidebar-subtitle {
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(247, 245, 240, 0.4);
    margin-bottom: 6px;
    display: block;
  }

  .sidebar-header h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 1.35rem;
    color: var(--pure-white);
    letter-spacing: 0.08em;
    margin: 0;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 40px 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .sidebar-links a {
    display: block;
    padding: 4px 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    color: var(--ivory);
    text-decoration: none;
    letter-spacing: 0.1em;
    opacity: 0.75;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar-links a:hover {
    color: var(--pure-white);
    opacity: 1;
    letter-spacing: 0.16em;
    transform: translateX(4px);
  }

  .sidebar-footer {
    border-top: 1px solid rgba(247, 245, 240, 0.08);
    padding-top: 24px;
  }

  .audio-btn {
    background: transparent;
    border: 1px solid rgba(247, 245, 240, 0.15);
    color: var(--ivory);
    padding: 10px 16px;
    border-radius: 0px; /* Sharp minimalist edges */
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    width: 100%;
    transition: all 0.3s ease;
  }

  .audio-btn:hover {
    background: rgba(247, 245, 240, 0.08);
    border-color: rgba(247, 245, 240, 0.35);
  }

  .audio-btn.playing {
    border-color: var(--pure-white);
    background: rgba(247, 245, 240, 0.05);
  }

  /* Responsive Adjustments for Mobile and Tablets */
  @media(max-width: 900px) {
    .page-container {
      flex-direction: column;
      height: auto;
    }

    .content-wrapper {
      padding: 60px 20px;
      justify-content: center;
    }

    .brand-block {
      padding: 35px 24px;
    }

    .sidebar-menu {
      width: 100%;
      min-height: auto;
      border-left: none;
      border-top: 1px solid rgba(247, 245, 240, 0.08);
      padding: 40px 24px;
    }

    .sidebar-links {
      margin: 25px 0;
      gap: 16px;
    }
  }
</style>